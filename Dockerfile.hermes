ARG GO_IMAGE=golang:1.25.8
ARG HERMES_BASE_IMAGE=nousresearch/hermes-agent:v2026.8.18

# Stage 1: Build gogcli
FROM ${GO_IMAGE} AS gogcli-builder

ARG GOGCLI_REF=e88964a1b1a46483fbc6a55ecbf2192ff522f2ea

WORKDIR /build
RUN git clone https://github.com/Pedrohgv/gogcli.git . && \
    git checkout "$GOGCLI_REF" && \
    make build

# Stage 2: Install pinned Bun runtime (deterministic, no installer script)
FROM ${HERMES_BASE_IMAGE} AS bun-installer

ARG BUN_VERSION=1.3.14
ARG BUN_SHA256=951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/bun-install
RUN curl -fsSL -o bun-linux-x64.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" \
    && echo "${BUN_SHA256}  bun-linux-x64.zip" > bun-linux-x64.zip.sha256 \
    && sha256sum -c bun-linux-x64.zip.sha256 \
    && unzip -q bun-linux-x64.zip \
    && mkdir -p /opt/bun/bin \
    && mv bun-linux-x64/bun /opt/bun/bin/bun \
    && chmod +x /opt/bun/bin/bun \
    && /opt/bun/bin/bun --version \
    && rm -rf /tmp/bun-install

# Stage 3: Install pinned gbrain CLI (deterministic ref, frozen lockfile)
FROM ${HERMES_BASE_IMAGE} AS gbrain-builder

ARG GBRAIN_REF=69aea15e8098dd2d7ac1813f8e42865186cd7c2a
# Patch file selectable via ARG so the upgrade-conformance BASELINE build can
# apply the HISTORICAL patch for a pre-upgrade pin (old ref ->
# patches/legacy/gbrain-inline-worker-gateway.0.42.73.2.patch; mapping in
# tests/runtime/gbrain_conformance_support.py, docs in tests/README.md and
# docs/gbrain-operations.md). Default and every production build use the
# canonical current patch. There is NO fallback/skip: a missing or
# non-applying selected file fails the build loudly.
ARG GBRAIN_PATCH_FILE=gbrain-inline-worker-gateway.patch

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=bun-installer /opt/bun/bin/bun /usr/local/bin/bun

RUN git clone https://github.com/garrytan/gbrain.git /opt/gbrain \
    && cd /opt/gbrain \
    && git checkout "$GBRAIN_REF" \
    && bun install --frozen-lockfile

# Josemar local patches to gbrain source (provider-agnostic):
#
# 1. (git apply) One patch maintaining these compatibility seams:
#    a. Provider API-key bridge/config (src/commands/config.ts,
#       src/core/ai/provider-env.ts, src/core/config.ts). Any *_api_key
#       config key is routed to the file plane, accepted without --force,
#       and folded into its uppercase *_API_KEY env var for providers
#       upstream does not map (DeepSeek, Groq, Together, etc.), so keys
#       written to the config file reach the gateway without depending on
#       process.env propagation (e.g. Hermes spawning gbrain). Complements
#       upstream mappings only for unrecognized provider keys.
#       Upstream bug: #3394
#    b. Gateway refresh + chronicle job registration (src/commands/jobs.ts).
#       chronicle_extract is registered via registerBuiltinJob and listed in
#       the gateway-refresh job coverage, so the LLM-backed worker refreshes
#       the gateway before running; without this it silently returned
#       no_events on PGLite (isAvailable('chat') is false).
#       Upstream bug: #3394
#    c. Embedding disable / keyword-only operations (src/core/ops/pages.ts,
#       src/core/ops/search.ts). put_page forces noEmbed when the
#       embedding_disabled sentinel is set, and the `query` op honors
#       search.mcp_keyword_only: keyword text search, loud rejection of
#       image/cross-modal queries that require the embedding transport.
#    d. E5 preprocess / revision signatures (src/core/ai/gateway.ts,
#       src/core/embedding.ts). Model-gated query:/passage: prefixing for
#       E5 models before truncation/batching/retry, plus a revision-aware
#       signature suffix (e5-query-passage-v1[@revision]) so raw or
#       revision-drifted vectors are detected as stale.
#    e. Embedding migration sentinel handling/finalization
#       (src/core/embedding-migration.ts, src/commands/migrate-embeddings.ts,
#       src/commands/embed.ts). E5-aware migration signature shared with the
#       embed loop; the embedding_disabled sentinel is lifted on successful
#       migration and on the verified-skip carve-out; a zero-failure stale
#       backfill finalizes a matching in-flight migration.
#    f. Bundled fixture (test/ai/e5-preprocess.test.ts). The patch adds its
#       own test file pinning the E5 seams; keep it in sync with the seams
#       above when re-creating the patch.
#    Note: chronicle judge maxTokens is no longer patched in source. Upstream
#    v0.42 exposes `chronicle.judge_max_tokens` (default 4000); Josemar sets it
#    to 8000 in the reindex flow (scripts/josemar-gbrain) so reasoning models
#    (e.g. DeepSeek deepseek-v4-flash) get headroom for the thinking chain.
#    Uses git apply so the build FAILS LOUDLY if gbrain restructures the
#    patched files. Verify patches still apply when changing GBRAIN_REF
#    (see docs/gbrain-operations.md → "gbrain Upgrade Checklist" item 7).
COPY patches/${GBRAIN_PATCH_FILE} /tmp/gbrain-inline-worker-gateway.patch
RUN cd /opt/gbrain \
    && test -f /tmp/gbrain-inline-worker-gateway.patch \
    && git apply /tmp/gbrain-inline-worker-gateway.patch \
    && rm /tmp/gbrain-inline-worker-gateway.patch

# Stage 4: Josemar-flavored Hermes image
FROM ${HERMES_BASE_IMAGE}

USER root

# Install Josemar skill/runtime dependencies not guaranteed by the base Hermes image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    gh \
    python3 \
    python3-pip \
    ca-certificates \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Josemar skill dependencies into both the Hermes venv (used by
# `docker compose exec` and Hermes-spawned subprocesses) and system Python
# (fallback for shells that reset PATH). The venv already has Markdown; only
# pymupdf is added there. System Python gets both.
#
# Mnemosyne pilot packages are pinned into the Hermes venv using the
# supported full dependency closure (no --no-deps). Remote TEI is the
# configured runtime embedding path; local FastEmbed/sqlite-vec extras may
# be pulled in by the dependency closure and are harmless when present. The
# package's supported dependency closure is preferred over a manual override
# for compatibility and package integrity. Provider activation is gated to
# runtime (docker-hermes-init.sh) so the image install alone does NOT enable
# Mnemosyne.
RUN /opt/hermes/.venv/bin/python3 -m ensurepip --upgrade \
    && /opt/hermes/.venv/bin/python3 -m pip install --no-cache-dir pymupdf \
    && /opt/hermes/.venv/bin/python3 -m pip install --no-cache-dir \
        mnemosyne-hermes==0.5.0 \
        mnemosyne-memory==3.15.1 \
    && /usr/bin/python3 -m pip install --no-cache-dir --break-system-packages --root-user-action=ignore \
       pymupdf Markdown==3.7

COPY scripts/patch-hermes-dashboard-profile-name.py /tmp/patch-hermes-dashboard-profile-name.py
RUN python3 /tmp/patch-hermes-dashboard-profile-name.py \
    && /opt/hermes/.venv/bin/python3 -m py_compile \
        /opt/hermes/hermes_cli/profiles.py \
        /opt/hermes/hermes_cli/web_server.py \
    && rm /tmp/patch-hermes-dashboard-profile-name.py

# Josemar state-backed skill toggles: copy the helper next to
# skills_config.py so the build-time patch can import it at runtime, then
# patch save_disabled_skills to route through the stateful helper that
# writes the canonical JSON sidecar before invoking native save_config.
COPY scripts/josemar_skill_state.py /opt/hermes/hermes_cli/josemar_skill_state.py
COPY scripts/patch-hermes-skills-config.py /tmp/patch-hermes-skills-config.py
RUN python3 /tmp/patch-hermes-skills-config.py \
    && /opt/hermes/.venv/bin/python3 -m py_compile \
        /opt/hermes/hermes_cli/skills_config.py \
        /opt/hermes/hermes_cli/josemar_skill_state.py \
    && rm /tmp/patch-hermes-skills-config.py

COPY --from=gogcli-builder /build/bin/gog /usr/local/bin/gog
RUN chmod +x /usr/local/bin/gog

# Install pinned Bun runtime on PATH
COPY --from=bun-installer /opt/bun/bin/bun /usr/local/bin/bun
RUN chmod +x /usr/local/bin/bun

# Install pinned gbrain CLI from the deterministic build stage. The native
# CLI lives at a private, non-PATH path (/opt/josemar/libexec/gbrain-native):
# the PUBLIC /usr/local/bin/gbrain is the issue #110 adapter, so no bare
# native gbrain remains reachable from a normal PATH.
COPY --from=gbrain-builder /opt/gbrain /opt/gbrain
RUN mkdir -p /opt/josemar/libexec \
    && printf '%s\n' '#!/bin/sh' 'cd /opt/gbrain && GBRAIN_SKIP_STARTUP_HOOKS=1 exec /usr/local/bin/bun run src/cli.ts "$@"' > /opt/josemar/libexec/gbrain-native \
    && chmod 755 /opt/josemar/libexec/gbrain-native

RUN mkdir -p /opt/josemar/skills /opt/josemar/hermes /opt/josemar/scripts

COPY skills-factory/aux-ml /opt/josemar/skills/aux-ml
COPY skills-factory/workspace-sync /opt/josemar/skills/workspace-sync
COPY skills-factory/gbrain /opt/josemar/skills/gbrain
COPY skills-factory/tasknotes /opt/josemar/skills/tasknotes
# browser-control is baked in (not overlay-mounted) so Josemar can guide
# first-time setup and self-diagnose when the overlay is disabled. The skill
# is instruction-only (SKILL.md + SETUP.md, no executable); the overlay still
# gates the tunnel sidecar and network, not the skill registration.
COPY skills-factory/browser-control /opt/josemar/skills/browser-control
# backup-operations is baked in like the other repo-owned skills: instruction-
# only agent-facing guidance (SKILL.md + references/, no executable).
COPY skills-factory/backup-operations /opt/josemar/skills/backup-operations
RUN chmod +x /opt/josemar/skills/aux-ml/aux-ml

# Canonical workspace-sync implementation (standard-library Python).
COPY scripts/workspace_sync.py /usr/local/bin/workspace-sync
RUN chmod +x /usr/local/bin/workspace-sync \
    && ln -s /usr/local/bin/workspace-sync /usr/local/bin/workspace-sync.sh \
    && rm -f /opt/josemar/skills/workspace-sync/workspace-sync \
    && ln -s /usr/local/bin/workspace-sync /opt/josemar/skills/workspace-sync/workspace-sync

COPY scripts/josemar-gbrain /usr/local/bin/josemar-gbrain
RUN chmod +x /usr/local/bin/josemar-gbrain

# Public gbrain IS the safe adapter (lock, root drop, allowlist, canonical
# env). gbrain-chat-run remains as a backwards-compatible symlink alias, not
# a duplicate script.
COPY scripts/gbrain_chat_run.py /usr/local/bin/gbrain
RUN chmod +x /usr/local/bin/gbrain \
    && ln -s /usr/local/bin/gbrain /usr/local/bin/gbrain-chat-run

COPY scripts/hermes-workspace-sync-cron.sh /opt/josemar/scripts/hermes-workspace-sync-cron.sh
COPY scripts/hermes-gbrain-refresh-cron.sh /opt/josemar/scripts/hermes-gbrain-refresh-cron.sh
COPY scripts/hermes-gbrain-embedding-refresh-cron.sh /opt/josemar/scripts/hermes-gbrain-embedding-refresh-cron.sh
COPY scripts/hermes-gbrain-embedding-refresh.py /opt/josemar/scripts/hermes-gbrain-embedding-refresh.py
COPY scripts/tasknotes_mcp_core.py scripts/tasknotes_mcp.py scripts/tasknotes_lock_run.py /opt/josemar/scripts/
# Vault-recovery export (Phase 1): Hermes-side exporter core + cron entrypoint
# + thin wrapper. Local staged immutable generations only; the remote
# uploader is phase 2 and ships in its own container.
COPY scripts/vault_recovery_core.py /opt/josemar/scripts/vault_recovery_core.py
COPY scripts/vault-recovery-export.sh /opt/josemar/scripts/vault-recovery-export.sh
COPY scripts/hermes-vault-recovery-export-cron.sh /opt/josemar/scripts/hermes-vault-recovery-export-cron.sh
# Vault-recovery restore (Phase 2): Hermes-side verify/install/rollback core
# + thin wrapper. The separate rclone uploader/recover services run in their
# own containers (docker-compose.vault-recovery.yml) and mount their scripts
# read-only; Hermes never sees the rclone config.
COPY scripts/vault_recovery_restore_core.py /opt/josemar/scripts/vault_recovery_restore_core.py
COPY scripts/vault-recovery-restore.sh /opt/josemar/scripts/vault-recovery-restore.sh
# Mnemosyne encrypted-backup core (Phase 2): Hermes-side exporter + restore
# helper. The separate rclone uploader service runs in its own container
# (docker-compose.mnemosyne-backup.yml) and mounts these scripts read-only.
COPY scripts/mnemosyne_backup_core.py /opt/josemar/scripts/mnemosyne_backup_core.py
COPY scripts/mnemosyne-backup-export.sh /opt/josemar/scripts/mnemosyne-backup-export.sh
COPY scripts/mnemosyne-backup-restore.sh /opt/josemar/scripts/mnemosyne-backup-restore.sh
# Backup-status: bounded direct local reader for the vault-recovery and
# mnemosyne staging lanes (operator/agent-facing; read-only, never touches
# remote state or writes anything). The bare PATH name is provided as a
# symlink (repo convention for agent-facing commands, like gbrain and
# workspace-sync); the canonical copy stays under /opt/josemar/scripts.
COPY scripts/josemar-backup-status.py /opt/josemar/scripts/josemar-backup-status.py
RUN chmod +x /opt/josemar/scripts/hermes-workspace-sync-cron.sh \
    /opt/josemar/scripts/hermes-gbrain-refresh-cron.sh \
    /opt/josemar/scripts/hermes-gbrain-embedding-refresh-cron.sh \
    /opt/josemar/scripts/hermes-gbrain-embedding-refresh.py \
    /opt/josemar/scripts/tasknotes_mcp.py \
    /opt/josemar/scripts/tasknotes_lock_run.py \
    /opt/josemar/scripts/mnemosyne-backup-export.sh \
    /opt/josemar/scripts/mnemosyne-backup-restore.sh \
    /opt/josemar/scripts/vault-recovery-export.sh \
    /opt/josemar/scripts/hermes-vault-recovery-export-cron.sh \
    /opt/josemar/scripts/vault-recovery-restore.sh \
    /opt/josemar/scripts/josemar-backup-status.py \
    && ln -s /opt/josemar/scripts/josemar-backup-status.py /usr/local/bin/josemar-backup-status \
    && /opt/hermes/.venv/bin/python3 -m compileall -q \
        /opt/josemar/scripts/tasknotes_mcp_core.py \
        /opt/josemar/scripts/tasknotes_mcp.py \
        /opt/josemar/scripts/tasknotes_lock_run.py \
        /opt/josemar/scripts/mnemosyne_backup_core.py \
        /opt/josemar/scripts/vault_recovery_core.py \
        /opt/josemar/scripts/vault_recovery_restore_core.py \
        /opt/josemar/scripts/josemar-backup-status.py

COPY config/hermes-config.yaml /opt/josemar/hermes/config.yaml
COPY docker-hermes-init.sh /etc/cont-init.d/00-josemar-setup
RUN chmod +x /etc/cont-init.d/00-josemar-setup
