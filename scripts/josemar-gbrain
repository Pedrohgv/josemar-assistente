# ---------------------------------------------------------------------------
# schema-status (read-only schema pack introspection; no gate required)
# ---------------------------------------------------------------------------

do_schema_status() {
    selected_pack="$GBRAIN_SCHEMA_PACK"
    is_bundled="false"
    if is_bundled_pack "$selected_pack"; then
        is_bundled="true"
    fi

    source_path=""
    source_sha256=""
    installed_path=""
    installed_sha256=""
    source_exists="false"
    installed_exists="false"

    if [ "$is_bundled" = "false" ]; then
        source_path=$(source_pack_path "$selected_pack")
        if [ -n "$source_path" ]; then
            source_exists="true"
            source_sha256=$(compute_sha256 "$source_path")
        fi
        installed_path=$(installed_pack_path "$selected_pack")
        if [ -n "$installed_path" ]; then
            installed_exists="true"
            installed_sha256=$(compute_sha256 "$installed_path")
        fi
    else
        # Bundled pack: report sentinel values.
        source_path="bundled"
        source_sha256="bundled"
        installed_path="bundled"
        installed_sha256="bundled"
        source_exists="true"
        installed_exists="true"
    fi

    # Read marker schema fields if marker exists.
    marker_source_sha256=""
    marker_installed_sha256=""
    marker_source_path=""
    marker_installed_path=""
    marker_schema_source_pack=""
    if marker_exists; then
        marker_schema_source_pack=$(marker_field "schema_source_pack")
        marker_source_path=$(marker_field "schema_source_path")
        marker_source_sha256=$(marker_field "schema_source_sha256")
        marker_installed_sha256=$(marker_field "schema_installed_sha256")
        marker_installed_path=$(marker_field "schema_installed_path")
    fi

    # Compute match status.
    source_hash_matches="false"
    installed_hash_matches="false"
    pack_matches="false"
    if [ "$marker_schema_source_pack" = "$selected_pack" ]; then
        pack_matches="true"
    fi
    if [ "$is_bundled" = "true" ]; then
        source_hash_matches="true"
        installed_hash_matches="true"
    else
        if [ -n "$source_sha256" ] && [ "$source_sha256" = "$marker_source_sha256" ]; then
            source_hash_matches="true"
        fi
        if [ -n "$installed_sha256" ] && [ "$installed_sha256" = "$marker_installed_sha256" ]; then
            installed_hash_matches="true"
        fi
    fi

    # Report marker_ok, marker_matches, gate_open (read-only, no gbrain config
    # reads — those happen in marker_matches_current which is gate-internal).
    marker_ok="false"
    marker_matches="false"
    gate_open="false"
    if marker_is_valid; then
        marker_ok="true"
        if marker_matches_current; then
            marker_matches="true"
        fi
    fi
    enabled="false"
    if [ "$GBRAIN_ENABLED" = "true" ]; then
        enabled="true"
    fi
    if [ "$enabled" = "true" ] && [ "$marker_ok" = "true" ] && [ "$marker_matches" = "true" ]; then
        gate_open="true"
    fi

    emit_json "$(python3 - "$selected_pack" "$is_bundled" "$source_exists" "$source_path" "$source_sha256" "$installed_exists" "$installed_path" "$installed_sha256" "$marker_schema_source_pack" "$marker_source_path" "$marker_source_sha256" "$marker_installed_sha256" "$marker_installed_path" "$pack_matches" "$source_hash_matches" "$installed_hash_matches" "$marker_ok" "$marker_matches" "$gate_open" <<'PY'
import json, sys
(selected, is_bundled, source_exists, source_path, source_sha256,
 installed_exists, installed_path, installed_sha256,
 m_source_pack, m_source_path, m_source_sha256, m_installed_sha256, m_installed_path,
 pack_matches, source_hash_matches, installed_hash_matches,
 marker_ok, marker_matches, gate_open) = sys.argv[1:20]
data = {
    "success": True,
    "action": "schema_status",
    "selected_pack": selected,
    "is_bundled": is_bundled == "true",
    "source_exists": source_exists == "true",
    "source_path": source_path,
    "source_sha256": source_sha256,
    "installed_exists": installed_exists == "true",
    "installed_path": installed_path,
    "installed_sha256": installed_sha256,
    "marker_source_pack": m_source_pack,
    "marker_source_path": m_source_path,
    "marker_source_sha256": m_source_sha256,
    "marker_installed_sha256": m_installed_sha256,
    "marker_installed_path": m_installed_path,
    "pack_matches": pack_matches == "true",
    "source_hash_matches": source_hash_matches == "true",
    "installed_hash_matches": installed_hash_matches == "true",
    "marker_ok": marker_ok == "true",
    "marker_matches": marker_matches == "true",
    "gate_open": gate_open == "true",
}
print(json.dumps(data, indent=2, ensure_ascii=False))
PY
)"
}

# ---------------------------------------------------------------------------
# reindex (operator-only initial activation)
# ---------------------------------------------------------------------------

do_reindex() {
    remove_marker

    # Validate schema pack name before any filesystem use.
    if ! validate_schema_pack_name "$GBRAIN_SCHEMA_PACK"; then
        return 1
    fi

    export_gbrain_env
    mkdir -p "$GBRAIN_STATE_DIR"

    # --- Schema source pack install (BEFORE init/sync/extract so gbrain
    # resolves the correct active pack during those operations) ---
    m_source_pack="$GBRAIN_SCHEMA_PACK"
    m_source_path=""
    m_source_sha256=""
    m_installed_sha256=""
    m_installed_path=""

    if is_bundled_pack "$GBRAIN_SCHEMA_PACK"; then
        # Bundled pack: no source to install. Record bundled sentinel.
        m_source_path="bundled"
        m_installed_path="bundled"
        m_source_sha256="bundled"
        m_installed_sha256="bundled"
    else
        # Custom pack: must have a source file. Fail early before init.
        src_path=$(source_pack_path "$GBRAIN_SCHEMA_PACK")
        if [ -z "$src_path" ]; then
            emit_json "$(python3 - "$GBRAIN_SCHEMA_PACK" <<'PY'
import json, sys
pack = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "schema_source_missing",
    "message": f"Custom schema pack '{pack}' source not found in $GBRAIN_SCHEMA_SOURCE_ROOT. Create the source pack or switch GBRAIN_SCHEMA_PACK to a bundled pack.",
}, ensure_ascii=False))
PY
)"
            return 1
        fi

        if ! validate_source_pack_path "$src_path"; then
            return 1
        fi

        m_source_path=$(resolve_realpath "$src_path")
        m_source_sha256=$(compute_sha256 "$src_path")
        if [ -z "$m_source_sha256" ]; then
            emit_json '{"success": false, "error": "schema_source_hash_failed", "message": "Failed to compute source pack sha256."}'
            return 1
        fi

        # Install (copy) to native user-pack directory.
        installed_path=$(install_source_pack "$src_path" "$GBRAIN_SCHEMA_PACK") || {
            return 1
        }
        m_installed_path=$(resolve_realpath "$installed_path")
        m_installed_sha256=$(compute_sha256 "$installed_path")
        if [ -z "$m_installed_sha256" ]; then
            emit_json '{"success": false, "error": "schema_install_hash_failed", "message": "Failed to compute installed pack sha256."}'
            return 1
        fi

        # Validate installed pack using native gbrain schema validate.
        if ! validate_installed_pack "$GBRAIN_SCHEMA_PACK"; then
            return 1
        fi
    fi

    # --- Native init: PGLite, no embedding ---
    init_output=$("$GBRAIN_BIN" init --pglite --no-embedding 2>&1) || {
        emit_json "$(python3 - "$init_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_init_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }
    if echo "$init_output" | grep -iE "\b(error|fatal|blocked|aborted|panic)\b" | grep -viE "no embedding|embedding disabled|warn|error_|_error|errors_|migration" >/dev/null 2>&1; then
        emit_json "$(python3 - "$init_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_init_blocked",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    fi

    config_output=$("$GBRAIN_BIN" config set link_resolution.global_basename true 2>&1) || {
        emit_json "$(python3 - "$config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_config_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    config_output=$("$GBRAIN_BIN" config set sync.repo_path "$GBRAIN_BRAIN_REPO" 2>&1) || {
        emit_json "$(python3 - "$config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_config_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    sync_output=$("$GBRAIN_BIN" sync --full --no-embed --yes --no-pull --json --repo "$GBRAIN_BRAIN_REPO" 2>&1) || {
        emit_json "$(python3 - "$sync_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_sync_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }
    if echo "$sync_output" | grep -iE "\"status\"[: ]*\"(partial|blocked|failed|error)\"|\b(fatal|blocked|aborted|panic)\b" | grep -viE "no embedding|embedding disabled|warn|no_embed" >/dev/null 2>&1; then
        emit_json "$(python3 - "$sync_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_sync_blocked",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    fi

    extract_output=$("$GBRAIN_BIN" extract --stale --json 2>&1) || {
        emit_json "$(python3 - "$extract_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_extract_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    # Extract the link graph (wikilinks → backlinks) from the DB so the
    # backlinks action returns populated results after reindex.
    extract_links_output=$("$GBRAIN_BIN" extract links --source db --json 2>&1) || {
        emit_json "$(python3 - "$extract_links_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_extract_links_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    keyword_config_output=$("$GBRAIN_BIN" config set search.mcp_keyword_only true 2>&1) || {
        emit_json "$(python3 - "$keyword_config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_config_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    # --- Native schema backfill: sync page.type for rows matching pack prefixes ---
    schema_sync_output=$("$GBRAIN_BIN" schema sync --apply --json 2>&1) || {
        emit_json "$(python3 - "$schema_sync_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "schema_sync_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    # --- Write activation marker with schema fields ---
    write_marker "$m_source_pack" "$m_source_path" "$m_source_sha256" "$m_installed_sha256" "$m_installed_path"

    emit_json "$(python3 - "$GBRAIN_SCHEMA_PACK" "$GBRAIN_PINNED_REF" "$GBRAIN_PINNED_VERSION" <<'PY'
import json, sys
schema, ref, version = sys.argv[1:4]
print(json.dumps({
    "success": True,
    "action": "reindex",
    "schema_pack": schema,
    "gbrain_ref": ref,
    "gbrain_version": version,
    "message": "Activation complete. The gate is open when GBRAIN_ENABLED is true and status reports gate_open=true.",
}, indent=2, ensure_ascii=False))
PY
)"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

usage() {
    emit_json '{"success": false, "error": "usage", "message": "Usage: josemar-gbrain {status|schema-status|search <json>|get <json>|capture <json>|put <json>|link <json>|backlinks <json>|reindex}"}'
    return 1
}

main() {
    subcommand="${1:-}"
    shift || true

    # Reject old note.* route names (both dotted and underscored) and
    # non-native surfaces that must not be exposed from chat.
    case "$subcommand" in
        note|note.*|note_*|query|call|sync|admin|files)
            emit_json "$(python3 - "$subcommand" <<'PY'
import json, sys
action = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "rejected_action",
    "message": f"Action '{action}' is not supported. Use: status, schema-status, search, get, capture, put, link, backlinks, reindex.",
}, ensure_ascii=False))
PY
)"
            return 1
            ;;
    esac

    case "$subcommand" in
        status)
            do_status
            ;;
        schema-status)
            do_schema_status
            ;;
        search)
            do_search "$@"
            ;;
        get)
            do_get "$@"
            ;;
        capture)
            do_capture "$@"
            ;;
        put)
            do_put "$@"
            ;;
        link)
            do_link "$@"
            ;;
        backlinks)
            do_backlinks "$@"
            ;;
        reindex)
            do_reindex
            ;;
        *)
            usage
            ;;
    esac
}

main "$@"
