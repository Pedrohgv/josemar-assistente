#!/bin/sh
# josemar-gbrain - operator-only reindex/activation wrapper around the pinned
# native gbrain CLI.
#
# Subcommands:
#   reindex - operator-only activation, state-aware (issue #124, issue #132):
#             fail-closed state preflight under the shared lock BEFORE any
#             native gbrain command (topology/file-plane/dotenv health); fresh
#             activation when both canonical artifacts are absent (init
#             --pglite --no-embedding + keyword-only), migrate-only init when
#             healthy existing; then config, sync, extract, extract links,
#             schema sync (if custom pack), git safe.directory.
#   refresh - recurring lightweight reconciliation for manual Obsidian edits:
#             Daily-links reconciliation cycle first (issue #139 W3: the
#             fixed reconciliation CLI runs prepare/apply/targeted commit,
#             then the native sync/extract below, then finalize only after
#             that sync returned success; the CLI is inert when the master
#             reconcile flag is disabled). No init/schema work.
#   embed-backfill - operator-only one-shot embedding backfill (issue #65).
#             Requires GBRAIN_EMBEDDING_MODEL and GBRAIN_EMBEDDING_DIMENSIONS,
#             acquires the tasknotes lock, runs `gbrain embed --stale
#             --include-null-signature` at concurrency 1, then asserts no
#             stale embeddings remain. Does NOT init or reinit PGLite.
#   enable-embeddings - operator-only non-destructive semantic-search switch
#             (issue #65). Requires the TEI-backed
#             GBRAIN_EMBEDDING_MODEL/DIMENSIONS, acquires the tasknotes lock,
#             FIRST forces search.mcp_keyword_only true (so any error path
#             leaves keyword-only enabled), runs `gbrain migrate embeddings
#             --to <model> --dim <dims> --yes --no-embed --ignore-env-override`
#             to persist file-plane config (clearing any persisted
#             embedding_disabled sentinel on success) and migrate schema
#             (preserving PGLite DB-only records), then ONLY on success sets
#             search.mcp_keyword_only false. Does NOT initiate backfill; does
#             NOT init or reinit PGLite. On migration failure keyword-only
#             stays enabled.
#   disable-embeddings - operator-only safe rollback to keyword-only (issue
#             #65). Acquires the shared tasknotes lock, sets
#             search.mcp_keyword_only true FIRST, then atomically writes
#             embedding_disabled=true into the file plane (config.json) via
#             Python so direct gbrain embedding operations (embed, import)
#             refuse via assertEmbeddingEnabled. The migration command is NOT
#             blocked (it does not call assertEmbeddingEnabled), so
#             enable-embeddings can later lift the sentinel. Vectors are
#             preserved (not deleted).
#
# Design:
#   - Native gbrain CLI only; no custom indexing/retrieval/ranking/authoring.
#   - Chat-facing actions (search, get, capture, put, link, backlinks, status)
#     run through the gbrain-chat-run adapter (issue #110): pinned native
#     binary, canonical env, root drop, and the shared lock. This wrapper is
#     operator/cron-only and never serves chat paths directly.
#   - reindex is manual only; nothing in startup/deploy calls it.
#   - refresh is safe for cron after activation. It deliberately uses
#     `--no-embed` while Josemar runs keyword-only; revisit when embeddings are
#     intentionally enabled.
#   - embed-backfill is operator-only and never called by cron/startup. The
#     daily refresh-embeddings path also produces embeddings, but only after
#     the manual backfill marker and semantic-mode checks pass.
#   - enable-embeddings/disable-embeddings are operator-only and never called
#     by cron/startup. enable-embeddings is the explicit, non-destructive
#     switch to semantic search (migration only, no backfill); disable-embeddings
#     is the safe rollback (keyword-only on, vectors preserved).
#   - refresh-embeddings is the sole chat-allowed maintenance command, but only
#     after an explicit user request. It owns the TaskNotes lock, reconciles
#     files without embedding, then embeds stale rows at concurrency 1.
#   - refresh and reindex acquire the shared tasknotes lock nonblocking before
#     any gbrain access (issue #110), so direct manual runs cannot open PGLite
#     while another holder is active. When the lock runner (refresh cron)
#     holds the lock it passes the lock fd to its child (TASKNOTES_LOCK_FD);
#     the wrapper validates that the inherited fd refers to the exact
#     configured lock and that a flock is actually held on it before skipping
#     self-acquisition — no env boolean can forge the skip.
#   - GBRAIN_SKIP_STARTUP_HOOKS=1 is exported for every wrapper-invoked gbrain
#     command to prevent gbrain's detached update-check network call.
#   - Results are returned in JSON envelopes.

set -eu

# Fixed deployment locations: never env-overridable. GBRAIN_HOME and
# GBRAIN_BRAIN_REPO would redirect gbrain at a caller-chosen PGLite/brain
# repo and GBRAIN_SCHEMA_SOURCE_ROOT at a caller-chosen pack source; all are
# security/location boundaries, so they are constants. Tests substitute
# these literals in a fixture copy. GBRAIN_SCHEMA_PACK stays an operational
# setting (which pack is active), as do the embedding configuration knobs.
GBRAIN_HOME="/opt/data"
GBRAIN_BRAIN_REPO="/opt/data/obsidian"
GBRAIN_SCHEMA_PACK="${GBRAIN_SCHEMA_PACK:-josemar}"
GBRAIN_SCHEMA_SOURCE_ROOT="/opt/data/.gbrain/schema-packs"

# Fixed production paths: never env-overridable. GBRAIN_BIN would execute an
# arbitrary binary and GBRAIN_TASKNOTES_LOCK would redirect the shared lock
# to a decoy; both are lock/binary security boundaries, so they are
# constants. Tests substitute these literals in a fixture copy.
GBRAIN_BIN="/opt/josemar/libexec/gbrain-native"
# Fixed native gbrain working directory: the launcher cds to /opt/gbrain, so
# the native process's Bun dotenv auto-load surface and the pin's own dotenv
# parsing are anchored there — never the wrapper caller's cwd. Constant:
# never env-overridable (it is a dotenv/location boundary).
GBRAIN_NATIVE_CWD="/opt/gbrain"
GBRAIN_TASKNOTES_LOCK="/opt/data/.locks/tasknotes.lock"
GBRAIN_STATE_DIR="${GBRAIN_HOME}/.gbrain"
# Canonical gbrain file-plane config: its existence as a regular file is the
# initialized-state surface for state-aware reindex (issue #124). Derived from
# the existing state-dir variable; no separate sentinel/state store.
GBRAIN_CONFIG_PATH="${GBRAIN_STATE_DIR}/config.json"
# Canonical PGLite data artifact (gbrainPath('brain.pglite')). Fresh init may
# run ONLY when BOTH canonical surfaces are absent and neither is a symlink
# (issue #124 gate-1 remediation).
GBRAIN_PGLITE_PATH="${GBRAIN_STATE_DIR}/brain.pglite"
GBRAIN_SCHEMA_PACK_MARKER="${GBRAIN_STATE_DIR}/active-schema-pack"

# Fixed interpreter/tool paths: no PATH resolution for anything that touches
# the lock, executes gbrain, or drops privileges.
PYTHON_BIN="/opt/hermes/.venv/bin/python3"
FLOCK_BIN="/usr/bin/flock"
SU_BIN="/usr/bin/su"
GETENT_BIN="/usr/bin/getent"
ID_BIN="/usr/bin/id"

# Lock runner re-entry: the wrapper acquires the flock itself (safe
# no-follow open) and then exec-replaces itself with the lock runner, which
# validates the inherited fd and protects the whole chain with a bounded
# process group. The runner ships at a fixed path in the image.
TASKNOTES_LOCK_RUNNER="/opt/josemar/scripts/tasknotes_lock_run.py"

# Fixed-purpose Daily-links reconciliation CLI (issue #139 W3). Installed
# at a fixed image path next to the TaskNotes MCP core (never
# env-overridable: it executes code). It validates the master reconcile
# flag strictly (inert when disabled), refuses root, requires the
# INHERITED shared tasknotes flock (this wrapper's), never acquires a lock
# itself, and never invokes the public gbrain wrapper.
TASKNOTES_RECONCILE_CLI="/opt/josemar/scripts/tasknotes_daily_links_reconcile.py"

# Manual/direct runs are unbounded by default (operator Ctrl-C is forwarded
# by the runner); cron invocations pass their own bounded --timeout.
LOCK_RUN_TIMEOUT="${GBRAIN_LOCK_RUN_TIMEOUT:-0}"
LOCK_RUN_KILL_GRACE="${GBRAIN_LOCK_RUN_KILL_GRACE:-5}"

# Lock shared with the TaskNotes MCP. embed-backfill acquires this lock
# nonblocking before any gbrain access to avoid concurrent vault writes.
GBRAIN_EMBEDDING_MARKER="${GBRAIN_STATE_DIR}/embedding-backfill-complete.json"

# Schema pack install directory (native gbrain user-pack discovery location).
SCHEMA_INSTALL_DIR="${GBRAIN_STATE_DIR}/schema-packs"
BUNDLED_PACKS="gbrain-base gbrain-base-v2 gbrain-recommended"

log() {
    echo "[josemar-gbrain] $1" >&2
}

emit_json() {
    printf '%s\n' "$1"
}

# Export the common gbrain runtime env (startup hooks off).
export_gbrain_env() {
    export GBRAIN_HOME
    export GBRAIN_BRAIN_REPO
    export GBRAIN_SCHEMA_PACK
    export GBRAIN_SKIP_STARTUP_HOOKS=1
}

# Verify the lock runner handed this process an inherited, actually-held
# lock fd (issue #110). Succeeds only when TASKNOTES_LOCK_FD refers to the
# exact configured lock file AND that fd's own open file description holds an
# EXCLUSIVE flock (writer) right now. The kernel exposes flock ownership per
# open file description in /proc/self/fdinfo: an unflocked fd (or an fd to
# any other file) shows no FLOCK lock line, and a shared LOCK_SH lock shows
# READ rather than the exclusive WRITE state — so an attacker-supplied
# boolean, shared lock, or fd to another file can never forge the skip;
# anything invalid fails closed and the caller falls back to self-acquisition.
lock_held_by_runner() {
    [ -n "${TASKNOTES_LOCK_FD:-}" ] || return 1
    "$PYTHON_BIN" -I - "$TASKNOTES_LOCK_FD" "$GBRAIN_TASKNOTES_LOCK" <<'PY'
import os, sys
try:
    fd = int(sys.argv[1])
    st_fd = os.fstat(fd)
    st_path = os.stat(sys.argv[2])
except (OSError, ValueError):
    sys.exit(1)
if (st_fd.st_dev, st_fd.st_ino) != (st_path.st_dev, st_path.st_ino):
    sys.exit(1)
try:
    with open(f"/proc/self/fdinfo/{fd}", encoding="utf-8") as fh:
        info = fh.read()
except OSError:
    sys.exit(1)
for line in info.splitlines():
    # Exclusive flock: "FLOCK ... WRITE". Shared (LOCK_SH) shows READ and
    # must NOT satisfy the check — a shared lock does not exclude other
    # exclusive holders.
    if line.startswith("lock:") and "FLOCK" in line and "WRITE" in line:
        sys.exit(0)
sys.exit(1)
PY
}

# Open the shared tasknotes lock on fd 9, creating it safely on a fresh
# deployment (the parent dir is created, the file is opened O_RDWR|O_CREAT
# without truncation) and rejecting symlinks with no check→open TOCTOU:
# after the open, a fixed-interpreter verification refuses any fd whose
# inode does not match a no-follow open of the path. Any failure emits the
# structured ${action}_lock_unavailable JSON and returns 1.
open_tasknotes_lock_fd() {
    action="$1"
    err_tag="$2"
    mkdir -p "${GBRAIN_TASKNOTES_LOCK%/*}" 2>/dev/null || {
        emit_json "{\"success\": false, \"action\": \"$action\", \"error\": \"${err_tag}_lock_unavailable\", \"message\": \"Could not open the tasknotes lock file.\"}"
        return 1
    }
    # Probe openability in a subshell first: a failed `exec` redirection
    # terminates the whole shell, so the probe keeps the failure in-shell.
    # The real open below is authoritative; any later failure stays
    # fail-closed (nonzero exit, no gbrain work).
    if ! ( : ) 9<>"$GBRAIN_TASKNOTES_LOCK" 2>/dev/null; then
        emit_json "{\"success\": false, \"action\": \"$action\", \"error\": \"${err_tag}_lock_unavailable\", \"message\": \"Could not open the tasknotes lock file.\"}"
        return 1
    fi
    exec 9<>"$GBRAIN_TASKNOTES_LOCK" 2>/dev/null
    if ! "$PYTHON_BIN" -I - "$GBRAIN_TASKNOTES_LOCK" <<'PY'
import os, sys
path = sys.argv[1]
try:
    st = os.fstat(9)
    probe = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
except OSError:
    sys.exit(1)
try:
    ok = (st.st_dev, st.st_ino) == (os.fstat(probe).st_dev, os.fstat(probe).st_ino)
finally:
    os.close(probe)
sys.exit(0 if ok else 1)
PY
    then
        exec 9<&- 2>/dev/null || true
        emit_json "{\"success\": false, \"action\": \"$action\", \"error\": \"${err_tag}_lock_unavailable\", \"message\": \"Could not open the tasknotes lock file.\"}"
        return 1
    fi
    return 0
}

# Acquire the shared TaskNotes/gbrain lock before any gbrain access so direct
# manual runs cannot open PGLite while another holder is active (issue #110),
# then re-enter through the lock runner so the whole chain is bounded and
# process-group protected.
#
# When the lock runner (refresh cron) already holds the lock it passes the
# lock fd to this process (TASKNOTES_LOCK_FD); lock_held_by_runner validates
# that the fd refers to the exact configured lock and that an exclusive
# flock is actually held on it, and only then does this become a no-op — no
# env boolean can forge the skip.
#
# Once THIS process acquires the flock (safe no-follow open, nonblocking),
# it exec-replaces itself with the lock runner (fixed interpreter, isolated
# mode): the runner validates the inherited fd, skips its own acquisition,
# and manages the process group, timeout, and signal cleanup. The flock is
# never released between the wrapper and the runner (same process via exec).
#
# Return codes: 0 = under the lock (skip or acquired+re-entered);
# 2 = lock busy (caller emits its specific busy JSON); 1 = unavailable.
run_under_lock() {
    action="$1"
    err_tag="$2"
    if lock_held_by_runner; then
        return 0
    fi
    open_tasknotes_lock_fd "$action" "$err_tag" || return 1
    if ! "$FLOCK_BIN" -n 9; then
        return 2
    fi
    export TASKNOTES_LOCK_FD=9
    exec "$PYTHON_BIN" -I "$TASKNOTES_LOCK_RUNNER" \
        --lock-path "$GBRAIN_TASKNOTES_LOCK" \
        --timeout "$LOCK_RUN_TIMEOUT" \
        --kill-grace "$LOCK_RUN_KILL_GRACE" \
        -- "$0" "$action"
    # Unreachable on success: exec replaces this process. On exec failure the
    # shell exits nonzero and the flock is released — fail closed.
    return 1
}

acquire_tasknotes_lock() {
    action="$1"
    run_under_lock "$action" "$action" || {
        case $? in
            2)
                emit_json "{\"success\": false, \"action\": \"$action\", \"error\": \"${action}_lock_busy\", \"message\": \"Could not acquire tasknotes lock; another holder is active.\"}"
                return 1
                ;;
            *)
                return 1
                ;;
        esac
    }
    return 0
}

# Resolve a realpath safely (portable, no readlink -f dependency on busybox).
resolve_realpath() {
    "$PYTHON_BIN" -I - "$1" <<'PY' 2>/dev/null || echo ""
import os, sys
try:
    print(os.path.realpath(sys.argv[1]))
except Exception:
    sys.exit(0)
PY
}

# ---------------------------------------------------------------------------
# Schema source pack helpers
# ---------------------------------------------------------------------------

# Check if a pack name is a bundled (read-only) pack.
is_bundled_pack() {
    pack_name="$1"
    for bundled in $BUNDLED_PACKS; do
        if [ "$pack_name" = "$bundled" ]; then
            return 0
        fi
    done
    return 1
}

# Compute the source pack path for the selected GBRAIN_SCHEMA_PACK.
# Returns empty string if the source file does not exist.
source_pack_path() {
    pack_name="$1"
    source_root="$GBRAIN_SCHEMA_SOURCE_ROOT"
    for ext in pack.yaml pack.yml pack.json; do
        candidate="${source_root}/${pack_name}/${ext}"
        if [ -f "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    echo ""
}

# Validate path confinement: reject symlinks, path escapes, and non-regular files.
# Emits error JSON and returns 1 on failure.
validate_source_pack_path() {
    src_path="$1"
    source_root="$GBRAIN_SCHEMA_SOURCE_ROOT"

    if [ -z "$src_path" ]; then
        return 1
    fi

    # Resolve realpaths for confinement check.
    src_real=$(resolve_realpath "$src_path")
    root_real=$(resolve_realpath "$source_root")

    if [ -z "$src_real" ] || [ -z "$root_real" ]; then
        emit_json '{"success": false, "error": "schema_source_invalid", "message": "Cannot resolve source pack path."}'
        return 1
    fi

    # Path must be under the source root.
    case "$src_real" in
        "${root_real}"/*)
            ;;
        *)
            emit_json '{"success": false, "error": "schema_source_path_escape", "message": "Source pack path is outside the schema source root."}'
            return 1
            ;;
    esac

    # Reject symlinks.
    if [ -L "$src_path" ]; then
        emit_json '{"success": false, "error": "schema_source_symlink", "message": "Source pack path is a symlink; only regular files are allowed."}'
        return 1
    fi

    return 0
}

# Install (copy) the source pack to the native user-pack directory.
# Removes stale alternate pack.yaml/pack.yml/pack.json before copying.
# Uses a temp file + atomic rename for crash safety.
# Emits error JSON and returns 1 on failure.
install_source_pack() {
    src_path="$1"
    pack_name="$2"
    install_dir="${SCHEMA_INSTALL_DIR}/${pack_name}"
    ext=$(echo "$src_path" | sed 's/.*\.//')
    dest_path="${install_dir}/pack.${ext}"

    mkdir -p "$install_dir"

    # Remove stale alternate extension files.
    for stale_ext in pack.yaml pack.yml pack.json; do
        stale_path="${install_dir}/${stale_ext}"
        if [ "$stale_path" != "$dest_path" ] && [ -f "$stale_path" ]; then
            rm -f "$stale_path"
        fi
    done

    # Atomic copy via temp file.
    tmp_dest="${dest_path}.tmp.$$"
    cp "$src_path" "$tmp_dest"
    if [ ! -f "$tmp_dest" ]; then
        emit_json '{"success": false, "error": "schema_install_failed", "message": "Failed to copy source pack to install directory."}'
        return 1
    fi
    mv "$tmp_dest" "$dest_path"
    if [ ! -f "$dest_path" ]; then
        emit_json '{"success": false, "error": "schema_install_failed", "message": "Failed to atomically install source pack."}'
        return 1
    fi
    echo "$dest_path"
}

# Validate a pack using native gbrain schema validate if available.
# Returns 0 if validation passes, 1 on failure (emits error JSON).
validate_installed_pack() {
    pack_name="$1"
    (
        export_gbrain_env
        "$GBRAIN_BIN" schema validate "$pack_name" >/dev/null 2>&1
    )
    rc=$?
    if [ "$rc" -ne 0 ]; then
        emit_json "$("$PYTHON_BIN" -I - "$pack_name" <<'PY'
import json, sys
pack = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "schema_validate_failed",
    "message": f"Native gbrain schema validate failed for pack '{pack}'. Check pack.yaml syntax and structure.",
}, ensure_ascii=False))
PY
)"
        return 1
    fi
    return 0
}

# Validate a schema pack name (lowercase slug-shape). Emits error JSON on failure.
validate_schema_pack_name() {
    name="$1"
    case "$name" in
        *[!a-z0-9._-]*)
            emit_json '{"success": false, "error": "invalid_schema_pack_name", "message": "GBRAIN_SCHEMA_PACK must be lowercase alphanumeric, dots, hyphens, or underscores."}'
            return 1
            ;;
    esac
    return 0
}

mark_brain_repo_safe_directory() {
    if [ -d "$GBRAIN_BRAIN_REPO" ]; then
        git config --global --add safe.directory "$GBRAIN_BRAIN_REPO" 2>/dev/null || true
    fi
}

# $1 = "full" to force a full sync (reindex), empty/omitted for incremental
# (refresh). All other flags are preserved: --no-embed --yes --no-pull --json
# --repo "$GBRAIN_BRAIN_REPO".
run_sync_extract_links() {
    sync_full_flag=""
    if [ "${1:-}" = "full" ]; then
        sync_full_flag="--full"
    fi
    sync_output=$("$GBRAIN_BIN" sync $sync_full_flag --no-embed --yes --no-pull --json --repo "$GBRAIN_BRAIN_REPO" 2>&1) || {
        emit_json "$("$PYTHON_BIN" -I - "$sync_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_sync_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }
    if echo "$sync_output" | grep -iE "\"status\"[: ]*\"(partial|blocked|failed|error)\"|\b(fatal|blocked|aborted|panic)\b" | grep -viE "no embedding|embedding disabled|warn|no_embed" >/dev/null 2>&1; then
        emit_json "$("$PYTHON_BIN" -I - "$sync_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_sync_blocked",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    fi

    extract_output=$("$GBRAIN_BIN" extract --stale --json 2>&1) || {
        emit_json "$("$PYTHON_BIN" -I - "$extract_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_extract_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    extract_links_output=$("$GBRAIN_BIN" extract links --source db --json 2>&1) || {
        emit_json "$("$PYTHON_BIN" -I - "$extract_links_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_extract_links_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }
}

# ---------------------------------------------------------------------------
# reindex (operator-only initial activation)
# ---------------------------------------------------------------------------

do_reindex() {
    # Validate schema pack name before any filesystem use.
    if ! validate_schema_pack_name "$GBRAIN_SCHEMA_PACK"; then
        return 1
    fi

    export_gbrain_env
    acquire_tasknotes_lock reindex || {
        return 1
    }
    # NOTE: no shell mkdir -p here — the state root (.gbrain) is established
    # fail-closed INSIDE the lock-held preflight below (no-follow parent open,
    # no-follow root open/create), so a symlinked .gbrain ancestor can never
    # be followed or pre-created (issue #132 fourth iteration).
    # Mark the vault repo as a git safe.directory before any native gbrain
    # operation that may inspect the repo. The command is idempotent and
    # best-effort; run this wrapper as the Hermes runtime user so the global
    # git config lands with the same ownership as chat/runtime commands.
    mark_brain_repo_safe_directory

    # --- State preflight (issue #132 Findings 1-2): fail-closed topology,
    # file-plane, and database env health check. Runs UNDER the shared lock
    # and BEFORE ANY native gbrain invocation, including the custom
    # schema-pack native validation below. Pure Python/shell: no gbrain
    # access, no config writes, no new sentinel, and no config content echoed
    # in diagnostics. The state ROOT (.gbrain) is established fail-closed
    # relative to the fixed parent (GBRAIN_HOME) with O_NOFOLLOW directory
    # opens: a symlinked parent/root/leaf can never redirect the classifier.
    # Healthy existing = regular non-symlink config.json (JSON object, engine
    # exactly pglite, database_path resolving to the canonical PGLite path,
    # no database_url) + non-symlink DIRECTORY brain.pglite; fresh = both
    # artifacts absent; everything else is a structured nonzero error.
    # Database env is enforced at the fixed native cwd boundary
    # (GBRAIN_NATIVE_CWD): direct inherited GBRAIN_DATABASE_URL, any Bun
    # default dotenv declaration of GBRAIN_DATABASE_URL there, and an
    # effective inherited DATABASE_URL (per the exact #427 heuristic against
    # the five dotenv files in that fixed cwd) all fail closed.
    preflight_output=$("$PYTHON_BIN" -I - "$GBRAIN_CONFIG_PATH" "$GBRAIN_PGLITE_PATH" "$GBRAIN_NATIVE_CWD" "$GBRAIN_HOME" <<'PY'
import json, os, re, stat, sys

config_path, pglite_path, native_cwd, parent_path = sys.argv[1:5]
root_leaf = ".gbrain"
config_leaf = os.path.basename(config_path)
pglite_leaf = os.path.basename(pglite_path)

def fail(code, message):
    print(json.dumps({"status": "error", "error": code, "message": message}, ensure_ascii=False))
    raise SystemExit

# Upstream loadConfig precedence (garrytan/gbrain@69aea15e): a truthy
# GBRAIN_DATABASE_URL selects Postgres unconditionally. The launcher unsets
# the inherited var, but the preflight still fails closed on it so the
# operator cannot silently run keyword-only PGLite with Postgres intent.
if os.environ.get("GBRAIN_DATABASE_URL"):
    fail("gbrain_state_gbrain_database_url_env",
         "GBRAIN_DATABASE_URL is set; the native CLI would select Postgres. Unset it and retry reindex.")

# The pin's #427 dotenv set (DATABASE_URL matching) and Bun's default dotenv
# surfaces (GBRAIN_DATABASE_URL declaration scan), both in the FIXED native
# cwd (/opt/gbrain) — the wrapper caller's cwd is never consulted.
DOTENV_FILES = (".env", ".env.local", ".env.development", ".env.production", ".env.test")
BUN_DOTENV_FILES = (".env", ".env.local", ".env.development", ".env.development.local",
                    ".env.production", ".env.production.local",
                    ".env.test", ".env.test.local")
DOTENV_RE = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$")

def read_lines(name):
    # newline="" disables universal-newline translation so a lone CR
    # survives read() and the LF-only split below is genuine.
    with open(os.path.join(native_cwd, name), encoding="utf-8", newline="") as fh:
        return fh.read().split("\n")

def dotenv_values_for_key(key, filenames):
    # Exact mirror of the pin's dotenvValuesForKey: fixed file names in the
    # fixed native cwd, unreadable/missing files skipped, lines split on
    # LF ONLY (a lone CR is not a line separator), then stripped, blank/#
    # skipped, pinned regex, case-sensitive key, trimmed value, whole-value
    # matching quote removal, else truncate at the first " #" AND trim the
    # remainder (upstream .trim()), empties ignored, union of all values.
    values = []
    for name in filenames:
        try:
            lines = read_lines(name)
        except OSError:
            continue
        for line in lines:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            m = DOTENV_RE.match(line)
            if not m:
                continue
            if m.group(1) != key:
                continue
            value = m.group(2).strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
                value = value[1:-1]
            else:
                comment = value.find(" #")
                if comment != -1:
                    value = value[:comment].strip()
            if value == "":
                continue
            values.append(value)
    return values

def declares_key(key, filenames):
    # Any syntactic declaration (even empty or quoted/expanded) counts; no
    # Bun expansion reimplementation, and no value is ever echoed.
    for name in filenames:
        try:
            lines = read_lines(name)
        except OSError:
            continue
        for line in lines:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            m = DOTENV_RE.match(line)
            if m and m.group(1) == key:
                return True
    return False

if declares_key("GBRAIN_DATABASE_URL", BUN_DOTENV_FILES):
    fail("gbrain_state_gbrain_database_url_dotenv",
         "A Bun default dotenv file in the fixed native gbrain cwd declares GBRAIN_DATABASE_URL; the operator intends Postgres. Remove the declaration and retry reindex.")

# DATABASE_URL selects Postgres only when truthy and NOT matched by a
# DATABASE_URL assignment in the pin's five dotenv files (fixed native cwd).
database_url_env = os.environ.get("DATABASE_URL") or ""
if database_url_env and database_url_env not in dotenv_values_for_key("DATABASE_URL", DOTENV_FILES):
    fail("gbrain_state_database_url_effective",
         "DATABASE_URL is set and not matched by a dotenv assignment in the fixed native gbrain cwd; the native CLI would select Postgres. Unset it or align the dotenv assignment and retry reindex.")

# --- State root establishment and artifact topology (all root-relative and
# no-follow; the root fd stays open through classification so an ancestor or
# leaf swap cannot redirect the classifier). Root-specific errors are above
# the exact leaf error codes, which are preserved.
parent_fd = None
root_fd = None
try:
    open_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        open_flags |= os.O_CLOEXEC

    # Fixed state parent (GBRAIN_HOME): must be a real directory; missing,
    # symlinked, non-directory, or inaccessible all fail statically (no path
    # or exception echo).
    try:
        parent_fd = os.open(parent_path, open_flags)
    except OSError:
        fail("gbrain_state_parent_invalid",
             "The fixed gbrain state parent cannot be opened safely; refusing reindex.")

    # State root (.gbrain): open no-follow; absent => create with umask
    # semantics via dir_fd, then immediately reopen no-follow; any existing
    # symlink (incl. dangling), regular file, non-directory, or inaccessible
    # root fails statically. Never follow, delete, repair, or migrate it.
    try:
        root_fd = os.open(root_leaf, open_flags, dir_fd=parent_fd)
    except FileNotFoundError:
        try:
            os.mkdir(root_leaf, 0o777, dir_fd=parent_fd)
        except OSError:
            fail("gbrain_state_root_create_failed",
                 "Could not create the gbrain state root safely; refusing reindex.")
        try:
            root_fd = os.open(root_leaf, open_flags, dir_fd=parent_fd)
        except OSError:
            fail("gbrain_state_root_create_failed",
                 "The gbrain state root could not be reopened after creation; refusing reindex.")
    except OSError:
        fail("gbrain_state_root_invalid",
             "The gbrain state root exists but is not a safe real directory; refusing reindex.")

    def root_mode(name):
        # No-follow stat relative to the validated root fd: a symlink (even
        # dangling) reports as a symlink, never as its target. ONLY a
        # genuinely absent leaf (ENOENT) classifies as missing; ANY other
        # inspection failure (EACCES, EIO, ESTALE, ...) is a structured
        # static error and must never be converted into a fresh state.
        try:
            return os.stat(name, dir_fd=root_fd, follow_symlinks=False).st_mode
        except FileNotFoundError:
            return 0
        except OSError:
            fail("gbrain_state_leaf_stat_failed",
                 "Could not inspect a state leaf under the gbrain state root; refusing reindex.")

    # Artifact topology: config.json must be a regular non-symlink file and
    # brain.pglite a non-symlink DIRECTORY; fresh only when BOTH are absent.
    config_mode = root_mode(config_leaf)
    pglite_mode = root_mode(pglite_leaf)

    if stat.S_ISLNK(config_mode):
        fail("gbrain_state_config_symlink", "Config path is a symlink; refusing reindex without clobbering it.")
    config_exists = config_mode != 0
    if config_exists and not stat.S_ISREG(config_mode):
        fail("gbrain_state_config_not_regular", "Config path exists but is not a regular file; refusing reindex.")
    if stat.S_ISLNK(pglite_mode):
        fail("gbrain_state_pglite_symlink", "PGLite data path is a symlink; refusing reindex without clobbering it.")
    pglite_exists = pglite_mode != 0
    if not config_exists and pglite_exists:
        fail("gbrain_state_pglite_without_config", "PGLite data exists but config.json is missing; refusing reindex over existing state.")
    if config_exists and not pglite_exists:
        fail("gbrain_state_config_without_pglite", "Config.json exists but the PGLite data directory is missing; refusing reindex.")
    if pglite_exists and not stat.S_ISDIR(pglite_mode):
        fail("gbrain_state_pglite_not_directory", "PGLite data path exists but is not a directory; refusing reindex.")

    if not config_exists:
        print(json.dumps({"status": "fresh"}, ensure_ascii=False))
        raise SystemExit

    # Existing file plane must be the exact healthy pglite shape; the config
    # is read root-relative with O_NOFOLLOW, and diagnostics are static
    # strings that never echo config content.
    try:
        cfg_fd = os.open(config_leaf, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=root_fd)
        with os.fdopen(cfg_fd, encoding="utf-8") as fh:
            cfg = json.load(fh)
    except (OSError, ValueError):
        fail("gbrain_state_config_malformed", "Config.json cannot be read or parsed as JSON; refusing reindex.")
    if not isinstance(cfg, dict):
        fail("gbrain_state_config_malformed", "Config.json is not a JSON object; refusing reindex.")
    if "database_url" in cfg:
        fail("gbrain_state_config_database_url_persisted", "Config.json persists database_url; refusing reindex over a Postgres config.")
    if cfg.get("engine") != "pglite":
        fail("gbrain_state_config_engine_invalid", "Config engine is not exactly pglite; refusing reindex.")
    database_path = cfg.get("database_path")
    if not isinstance(database_path, str) or not database_path:
        fail("gbrain_state_config_database_path_invalid", "Config database_path is missing or not a string; refusing reindex.")
    if os.path.realpath(database_path) != os.path.realpath(pglite_path):
        fail("gbrain_state_config_database_path_invalid", "Config database_path does not resolve to the canonical PGLite path; refusing reindex.")

    print(json.dumps({"status": "existing"}, ensure_ascii=False))
finally:
    if root_fd is not None:
        try:
            os.close(root_fd)
        except OSError:
            pass
    if parent_fd is not None:
        try:
            os.close(parent_fd)
        except OSError:
            pass
PY
) || {
        emit_json '{"success": false, "action": "reindex", "error": "gbrain_state_preflight_failed", "message": "Could not run the reindex state preflight."}'
        return 1
    }
    # Parse the preflight output by EXACT match only: the state variable is
    # bound to exactly 'fresh' or 'existing'; ANY other output (garbage,
    # embedded/partial status substrings, or surprises from a future change)
    # fails through the structured preflight envelope. Init is chosen from
    # this variable only — no filesystem reclassification happens later.
    case "$preflight_output" in
        '{"status": "fresh"}')
            preflight_state="fresh"
            ;;
        '{"status": "existing"}')
            preflight_state="existing"
            ;;
        *)
            emit_json "$("$PYTHON_BIN" -I - "$preflight_output" <<'PY'
import json, sys
try:
    r = json.loads(sys.argv[1])
    code = r["error"]
    message = r["message"]
except Exception:
    code = "gbrain_state_preflight_failed"
    message = "State preflight returned an unparseable result."
print(json.dumps({
    "success": False,
    "action": "reindex",
    "error": code,
    "message": message,
}, ensure_ascii=False))
PY
)"
            return 1
            ;;
    esac

    # --- Schema source pack install (BEFORE init/sync/extract so gbrain
    # resolves the correct active pack during those operations) ---
    if ! is_bundled_pack "$GBRAIN_SCHEMA_PACK"; then
        # Custom pack: must have a source file. Fail early before init.
        src_path=$(source_pack_path "$GBRAIN_SCHEMA_PACK")
        if [ -z "$src_path" ]; then
            emit_json "$("$PYTHON_BIN" -I - "$GBRAIN_SCHEMA_PACK" <<'PY'
import json, sys
pack = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "schema_source_missing",
    "message": f"Custom schema pack '{pack}' source not found in $GBRAIN_SCHEMA_SOURCE_ROOT. Create the source pack or switch GBRAIN_SCHEMA_PACK to a bundled pack.",
}, ensure_ascii=False))
PY
)"
            return 1
        fi

        if ! validate_source_pack_path "$src_path"; then
            return 1
        fi

        # Install (copy) to native user-pack directory.
        install_source_pack "$src_path" "$GBRAIN_SCHEMA_PACK" >/dev/null || {
            return 1
        }

        # Validate installed pack using native gbrain schema validate.
        if ! validate_installed_pack "$GBRAIN_SCHEMA_PACK"; then
            return 1
        fi
    fi

    # --- Init selection: driven EXCLUSIVELY by the validated preflight
    # state variable (fresh|existing). No filesystem reclassification
    # happens here — the preflight is the single authority. Existing => run
    # ONLY `init --migrate-only` (loads the existing config, runs schema
    # init; no saveConfig, no fresh provider setup) — failure is structured,
    # nonzero, and terminal with no fresh fallback. Fresh (both artifacts
    # absent per the preflight) => full PGLite init without embedding, then
    # keyword-only mode. No config writes and no new sentinel store here.
    if [ "$preflight_state" = "existing" ]; then
        # --- Healthy existing: migrate-only init only; the existing search
        # mode and provider config are preserved. ---
        init_output=$("$GBRAIN_BIN" init --migrate-only 2>&1) || {
            emit_json "$("$PYTHON_BIN" -I - "$init_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_init_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            return 1
        }
        if echo "$init_output" | grep -iE "\b(error|fatal|blocked|aborted|panic)\b" | grep -viE "no embedding|embedding disabled|warn|error_|_error|errors_|migration" >/dev/null 2>&1; then
            emit_json "$("$PYTHON_BIN" -I - "$init_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_init_blocked",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            return 1
        fi
    else
        # --- Fresh: PGLite init, no embedding, then keyword-only search
        # mode. ---
        init_output=$("$GBRAIN_BIN" init --pglite --no-embedding 2>&1) || {
            emit_json "$("$PYTHON_BIN" -I - "$init_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_init_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            return 1
        }
        if echo "$init_output" | grep -iE "\b(error|fatal|blocked|aborted|panic)\b" | grep -viE "no embedding|embedding disabled|warn|error_|_error|errors_|migration" >/dev/null 2>&1; then
            emit_json "$("$PYTHON_BIN" -I - "$init_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_init_blocked",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            return 1
        fi

        # Fresh activation pins keyword-only search mode (semantic mode is
        # enabled only by an explicit later operator action, issue #65).
        config_output=$("$GBRAIN_BIN" config set search.mcp_keyword_only true 2>&1) || {
            emit_json "$("$PYTHON_BIN" -I - "$config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_config_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            return 1
        }
    fi

    config_output=$("$GBRAIN_BIN" config set sync.repo_path "$GBRAIN_BRAIN_REPO" 2>&1) || {
        emit_json "$("$PYTHON_BIN" -I - "$config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_config_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    config_output=$("$GBRAIN_BIN" config set link_resolution.global_basename true 2>&1) || {
        emit_json "$("$PYTHON_BIN" -I - "$config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_config_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    # Chronicle judge maxTokens: upstream v0.42 exposes
    # `chronicle.judge_max_tokens` (default 4000). Reasoning models
    # (e.g. DeepSeek deepseek-v4-flash) need more tokens for the thinking
    # chain before producing output, so raise it to 8000 at activation.
    # This replaces the old source patch that bumped the hardcoded 1500.
    config_output=$("$GBRAIN_BIN" config set chronicle.judge_max_tokens 8000 2>&1) || {
        emit_json "$("$PYTHON_BIN" -I - "$config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_config_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    run_sync_extract_links full || {
        return 1
    }

    # --- Native schema backfill: sync page.type for rows matching pack prefixes.
    # Run only when a custom schema pack is in use.
    if ! is_bundled_pack "$GBRAIN_SCHEMA_PACK"; then
        schema_sync_output=$("$GBRAIN_BIN" schema sync --apply --json 2>&1) || {
            emit_json "$("$PYTHON_BIN" -I - "$schema_sync_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "schema_sync_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            return 1
        }
    fi

    # Persist the activated schema pack as the runtime source of truth for
    # agent-facing calls (gbrain-chat-run reads this fixed path instead of
    # guessing; the adapter fails closed to the canonical pack when missing).
    # The write is REQUIRED and atomic: temp file in the same directory,
    # fsync, rename (atomically replacing any stale marker), then a directory
    # fsync for durability. Path safety is fail-closed: a symlinked marker or
    # symlinked parent is refused (no clobber of a decoy), and any failure is
    # a structured nonzero error — reindex must not report success without
    # the marker. The lock is held throughout (acquired at the top of
    # do_reindex and released only when the wrapper exits).
    if ! "$PYTHON_BIN" -I - "$GBRAIN_SCHEMA_PACK_MARKER" "$GBRAIN_SCHEMA_PACK" <<'PY'
import os, sys, tempfile
path, pack = sys.argv[1:3]
parent = os.path.dirname(path)
tmp = None
try:
    # Fail closed: the parent must be a real directory, not a symlink.
    if os.path.islink(parent) or not os.path.isdir(parent):
        sys.exit(1)
    # Fail closed: the marker itself must not be a symlink.
    if os.path.islink(path):
        sys.exit(1)
    fd, tmp = tempfile.mkstemp(dir=parent, prefix="active-schema-pack.", suffix=".tmp")
    try:
        os.write(fd, (pack + "\n").encode("utf-8"))
        os.fsync(fd)
    finally:
        os.close(fd)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)  # atomic replacement of any stale marker
    tmp = None
    dfd = os.open(parent, os.O_RDONLY)
    try:
        os.fsync(dfd)  # durability: make the rename itself persistent
    finally:
        os.close(dfd)
except (OSError, ValueError):
    if tmp is not None:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    sys.exit(1)
sys.exit(0)
PY
    then
        emit_json '{"success": false, "action": "reindex", "error": "schema_pack_marker_write_failed", "message": "Could not persist the active schema pack marker; reindex is not complete."}'
        return 1
    fi

    emit_json "$("$PYTHON_BIN" -I - "$GBRAIN_SCHEMA_PACK" <<'PY'
import json, sys
schema = sys.argv[1]
print(json.dumps({
    "success": True,
    "action": "reindex",
    "schema_pack": schema,
    "message": "Activation complete. Operator access: josemar-gbrain; agent-facing access: gbrain-chat-run.",
}, indent=2, ensure_ascii=False))
PY
)"
}

do_refresh() {
    export_gbrain_env
    acquire_tasknotes_lock refresh || {
        return 1
    }
    mkdir -p "$GBRAIN_STATE_DIR"
    mark_brain_repo_safe_directory

    # Issue #139 W3: Daily-links reconciliation cycle under the inherited
    # shared lock, in the required order: prepare/apply/targeted commit
    # (fixed CLI) -> native sync/extract -> finalize ONLY after that sync
    # returned success. Any failure fails refresh without advancing the
    # cursor (the W2 cursor/pending stay replayable). The fixed CLI
    # validates the master reconcile flag strictly and is completely
    # inert when the feature is disabled (default).
    reconcile_output=$("$PYTHON_BIN" -I "$TASKNOTES_RECONCILE_CLI" reconcile 2>&1) || {
        emit_json "$("$PYTHON_BIN" -I - "$reconcile_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "action": "refresh",
    "error": "daily_links_reconcile_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    run_sync_extract_links || {
        return 1
    }

    finalize_output=$("$PYTHON_BIN" -I "$TASKNOTES_RECONCILE_CLI" finalize 2>&1) || {
        emit_json "$("$PYTHON_BIN" -I - "$finalize_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "action": "refresh",
    "error": "daily_links_finalize_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
        return 1
    }

    emit_json '{"success": true, "action": "refresh", "message": "gbrain refreshed from vault files. Embeddings skipped by design."}'
}

# Explicit-request semantic refresh. The shared lock is owned here (not by the
# Hermes cron entrypoint) and validation is performed while it is held.
# Under the lock, the wrapper re-enters through the lock runner so the whole
# chain is process-group and timeout protected even for direct chat
# invocations; a busy lock skips gracefully (the embedding cron's contract).
do_refresh_embeddings() {
    export_gbrain_env
    mkdir -p "$GBRAIN_STATE_DIR"
    mark_brain_repo_safe_directory
    run_under_lock refresh-embeddings refresh_embeddings || {
        case $? in
            2)
                emit_json '{"success": true, "action": "refresh-embeddings", "status": "skipped", "reason": "lock_busy"}'
                return 0
                ;;
            *)
                return 1
                ;;
        esac
    }
        keyword_only=$("$GBRAIN_BIN" config get search.mcp_keyword_only 2>/dev/null) || {
            emit_json '{"success": false, "action": "refresh-embeddings", "error": "refresh_embeddings_config_read_failed", "message": "Could not read search.mcp_keyword_only from gbrain."}'
            exit 1
        }
        if [ "$keyword_only" = "true" ]; then
            emit_json '{"success": true, "action": "refresh-embeddings", "status": "skipped", "reason": "keyword_only"}'
            exit 0
        fi
        if [ "$keyword_only" != "false" ]; then
            emit_json '{"success": false, "action": "refresh-embeddings", "error": "refresh_embeddings_semantic_mode_invalid", "message": "gbrain config get search.mcp_keyword_only must print exactly false"}'
            exit 1
        fi
        validation=$("$PYTHON_BIN" -I - "$GBRAIN_STATE_DIR/config.json" "$GBRAIN_EMBEDDING_MARKER" "${GBRAIN_EMBEDDING_MODEL:-}" "${GBRAIN_EMBEDDING_DIMENSIONS:-}" "${GBRAIN_EMBEDDING_MODEL_REVISION:-}" <<'PY'
import json, os, sys
config_path, marker_path, model, dimensions, revision = sys.argv[1:]
def result(status, **extra):
    print(json.dumps({"status": status, **extra}, ensure_ascii=False))
if not os.path.exists(config_path):
    result("skip", reason="uninitialized"); raise SystemExit
try:
    with open(config_path, encoding="utf-8") as fh: config = json.load(fh)
except Exception as exc:
    result("fail", error="refresh_embeddings_config_corrupt", message=str(exc)); raise SystemExit
if not isinstance(config, dict):
    result("fail", error="refresh_embeddings_config_corrupt", message="config.json is not an object"); raise SystemExit
sentinel = config.get("embedding_disabled")
if sentinel is not None and not isinstance(sentinel, bool):
    result("fail", error="refresh_embeddings_invalid_sentinel", message="embedding_disabled must be boolean"); raise SystemExit
if sentinel is True:
    result("skip", reason="embedding_disabled"); raise SystemExit
if not os.path.exists(marker_path):
    result("skip", reason="completion_marker_missing"); raise SystemExit
try:
    with open(marker_path, encoding="utf-8") as fh: marker = json.load(fh)
except Exception as exc:
    result("fail", error="refresh_embeddings_marker_malformed", message=str(exc)); raise SystemExit
if (not isinstance(marker, dict) or set(marker) != {"model", "dimensions", "revision"
        } or not isinstance(marker["dimensions"], int) or isinstance(marker["dimensions"], bool)):
    result("fail", error="refresh_embeddings_marker_malformed", message="marker must contain exactly model, dimensions, revision"); raise SystemExit
try:
    matches = (marker["model"] == model and int(marker["dimensions"]) == int(dimensions)
               and marker["revision"] == revision and all(isinstance(marker[k], str) and marker[k] for k in ("model", "revision")))
except (TypeError, ValueError):
    matches = False
if not matches:
    result("fail", error="refresh_embeddings_marker_tuple_mismatch", message="completion marker does not match the configured embedding tuple"); raise SystemExit
result("run")
PY
        )
        case "$validation" in
            *'"status": "skip"'*) emit_json "$("$PYTHON_BIN" -I - "$validation" <<'PY'
import json, sys
r=json.loads(sys.argv[1]); print(json.dumps({"success": True, "action": "refresh-embeddings", "status": "skipped", "reason": r["reason"]}))
PY
)"; exit 0 ;;
            *'"status": "fail"'*) emit_json "$("$PYTHON_BIN" -I - "$validation" <<'PY'
import json, sys
r=json.loads(sys.argv[1]); print(json.dumps({"success": False, "action": "refresh-embeddings", "error": r["error"], "message": r["message"]}))
PY
)"; exit 1 ;;
        esac
        run_sync_extract_links || exit 1
        embed_output=$(GBRAIN_EMBED_CONCURRENCY=1 "$GBRAIN_BIN" embed --stale 2>&1) || {
            emit_json "$("$PYTHON_BIN" -I - "$embed_output" <<'PY'
import json, sys
print(json.dumps({"success": False, "action": "refresh-embeddings", "error": "gbrain_embed_failed", "message": sys.argv[1][:4000]}))
PY
)"
            exit 1
        }
        emit_json '{"success": true, "action": "refresh-embeddings", "message": "gbrain refreshed and stale embeddings processed."}'
}

# ---------------------------------------------------------------------------
# embed-backfill (operator-only one-shot embedding backfill, issue #65)
# ---------------------------------------------------------------------------
#
# Unlike reindex/refresh, this subcommand produces embeddings. It does NOT
# init or reinit PGLite; it assumes an already-activated gbrain state dir.
# It requires GBRAIN_EMBEDDING_MODEL and GBRAIN_EMBEDDING_DIMENSIONS to be set
# and nonempty, acquires the tasknotes lock nonblocking, runs
# `gbrain embed --stale --include-null-signature` at concurrency 1, then
# asserts no stale embeddings remain via a dry-run equivalent.

do_embed_backfill() {
    # Prerequisite: embedding model + dimensions must be set and nonempty.
    if [ -z "${GBRAIN_EMBEDDING_MODEL:-}" ] || [ -z "${GBRAIN_EMBEDDING_DIMENSIONS:-}" ] || [ -z "${GBRAIN_EMBEDDING_MODEL_REVISION:-}" ]; then
        emit_json '{"success": false, "error": "embed_backfill_prerequisites_missing", "message": "GBRAIN_EMBEDDING_MODEL and GBRAIN_EMBEDDING_DIMENSIONS must be set and nonempty to run embed-backfill."}'
        return 1
    fi

    export_gbrain_env
    mkdir -p "$GBRAIN_STATE_DIR"
    mark_brain_repo_safe_directory

    # Acquire the tasknotes lock nonblocking before any gbrain access (safe
    # no-follow open with creation), then re-enter under the lock runner for
    # process-group/timeout protection.
    run_under_lock embed-backfill embed_backfill || {
        case $? in
            2)
                emit_json '{"success": false, "error": "embed_backfill_lock_busy", "message": "Could not acquire tasknotes lock; another holder is active."}'
                return 1
                ;;
            *)
                return 1
                ;;
        esac
    }

        # Run the embedding backfill at concurrency 1.
        embed_output=$(
            GBRAIN_EMBED_CONCURRENCY=1 "$GBRAIN_BIN" embed --stale --include-null-signature 2>&1
        ) || {
            emit_json "$("$PYTHON_BIN" -I - "$embed_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_embed_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            exit 1
        }

        # Dry-run equivalent: assert no stale embeddings remain.
        verify_output=$(
            GBRAIN_EMBED_CONCURRENCY=1 "$GBRAIN_BIN" embed --stale --include-null-signature --dry-run 2>&1
        ) || {
            emit_json "$("$PYTHON_BIN" -I - "$verify_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "embed_backfill_verify_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            exit 1
        }
        if echo "$verify_output" | grep -iE "\bstale\b" | grep -viE "no stale|0 stale|no rows|0 rows" >/dev/null 2>&1; then
            emit_json "$("$PYTHON_BIN" -I - "$verify_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "embed_backfill_stale_remaining",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            exit 1
        fi

        # The marker is the durable completion record for the exact migration
        # tuple. Write it only after the zero-stale check, atomically. A write
        # failure is an explicit structured nonzero error — it cannot claim
        # success and must not fall through to the block-level
        # lock_unavailable handler.
        if ! "$PYTHON_BIN" -I - "$GBRAIN_EMBEDDING_MARKER" "$GBRAIN_EMBEDDING_MODEL" "$GBRAIN_EMBEDDING_DIMENSIONS" "$GBRAIN_EMBEDDING_MODEL_REVISION" <<'PY'
import json, os, sys, tempfile
path, model, dimensions, revision = sys.argv[1:]
parent = os.path.dirname(path)
os.makedirs(parent, exist_ok=True)
payload = {"model": model, "dimensions": int(dimensions), "revision": revision}
fd, tmp = tempfile.mkstemp(dir=parent, prefix="embedding-backfill-complete.", suffix=".tmp")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, sort_keys=True)
        fh.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
except Exception as exc:
    try: os.unlink(tmp)
    except OSError: pass
    print(json.dumps({
        "success": False,
        "error": "embed_backfill_marker_write_failed",
        "message": f"Could not write the embedding-backfill completion marker: {exc}",
    }, ensure_ascii=False))
    sys.exit(1)
PY
        then
            exit 1
        fi

        emit_json '{"success": true, "action": "embed-backfill", "message": "Embedding backfill complete; no stale embeddings remain."}'
}

# ---------------------------------------------------------------------------
# enable-embeddings (operator-only non-destructive semantic-search switch,
# issue #65)
# ---------------------------------------------------------------------------
#
# Unlike embed-backfill, this subcommand does NOT produce embeddings. It is
# the explicit, non-destructive switch from keyword-only to semantic search:
#   1. Require the TEI-backed GBRAIN_EMBEDDING_MODEL and
#      GBRAIN_EMBEDDING_DIMENSIONS (nonempty).
#   2. Acquire the shared tasknotes lock nonblocking before any gbrain access.
#   3. FIRST force search.mcp_keyword_only true so any error path leaves
#      keyword-only enabled (graceful degradation to keyword search).
#   4. Run `gbrain migrate embeddings --to <model> --dim <dims> --yes --no-embed
#      --ignore-env-override` to persist file-plane config (clearing any
#      persisted embedding_disabled sentinel on success) and migrate schema
#      while preserving PGLite DB-only records (--no-embed skips the re-embed
#      pass; --ignore-env-override proceeds even when GBRAIN_EMBEDDING_* env
#      vars would override the target at runtime).
#   5. ONLY after a successful migration, set search.mcp_keyword_only false to
#      enable semantic search.
#   6. Do NOT initiate backfill itself — run embed-backfill separately.
#
# On any migration failure, keyword-only stays enabled (true) so retrieval
# degrades gracefully to keyword search rather than serving wrong/empty
# semantic results. No init or reinit-pglite is performed.

do_enable_embeddings() {
    # Prerequisite: embedding model + dimensions must be set and nonempty.
    if [ -z "${GBRAIN_EMBEDDING_MODEL:-}" ] || [ -z "${GBRAIN_EMBEDDING_DIMENSIONS:-}" ]; then
        emit_json '{"success": false, "error": "enable_embeddings_prerequisites_missing", "message": "GBRAIN_EMBEDDING_MODEL and GBRAIN_EMBEDDING_DIMENSIONS must be set and nonempty to run enable-embeddings."}'
        return 1
    fi

    export_gbrain_env
    mkdir -p "$GBRAIN_STATE_DIR"
    mark_brain_repo_safe_directory

    # Acquire the tasknotes lock nonblocking before any gbrain access (safe
    # no-follow open with creation), then re-enter under the lock runner.
    run_under_lock enable-embeddings enable_embeddings || {
        case $? in
            2)
                emit_json '{"success": false, "error": "enable_embeddings_lock_busy", "message": "Could not acquire tasknotes lock; another holder is active."}'
                return 1
                ;;
            *)
                return 1
                ;;
        esac
    }

        # FIRST force keyword-only true so any error path leaves keyword-only
        # enabled. This is the safe default: even if migration fails, retrieval
        # degrades gracefully to keyword search.
        config_output=$("$GBRAIN_BIN" config set search.mcp_keyword_only true 2>&1) || {
            emit_json "$("$PYTHON_BIN" -I - "$config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "enable_embeddings_keyword_only_force_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            exit 1
        }

        # A new migration removes the previous completion tuple. Remove it
        # before migration so a failed migration cannot appear complete. A
        # removal failure is an explicit structured nonzero error.
        rm -f "$GBRAIN_EMBEDDING_MARKER" || {
            emit_json '{"success": false, "error": "enable_embeddings_marker_removal_failed", "message": "Could not remove the previous embedding completion marker."}'
            exit 1
        }

        # Run the non-destructive migration: persist file-plane config, migrate
        # schema, invalidate stale signatures, but do NOT re-embed (--no-embed).
        # --ignore-env-override proceeds even when GBRAIN_EMBEDDING_* env vars
        # would override the target at runtime (the operator has set them
        # intentionally as the source of truth). The migration also clears any
        # persisted embedding_disabled sentinel on success (issue #65).
        migrate_output=$(
            "$GBRAIN_BIN" migrate embeddings --to "$GBRAIN_EMBEDDING_MODEL" --dim "$GBRAIN_EMBEDDING_DIMENSIONS" --yes --no-embed --ignore-env-override 2>&1
        ) || {
            emit_json "$("$PYTHON_BIN" -I - "$migrate_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_migrate_embeddings_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            exit 1
        }
        # Guard against a non-zero-exit masked by subshell quirks: scan the
        # output for hard failure markers the migrate command prints on
        # refused/failed apply (it does not always exit nonzero on --json).
        if echo "$migrate_output" | grep -iE "\"status\"[: ]*\"(refused|failed)\"|\b(fatal|aborted|panic)\b" | grep -viE "warn|no_embed|no-embed" >/dev/null 2>&1; then
            emit_json "$("$PYTHON_BIN" -I - "$migrate_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "gbrain_migrate_embeddings_blocked",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            exit 1
        fi

        # ONLY after a successful migration, flip keyword-only off to enable
        # semantic search. On any migration failure above, we exit before
        # reaching this line, so keyword-only stays enabled (true).
        config_output=$("$GBRAIN_BIN" config set search.mcp_keyword_only false 2>&1) || {
            emit_json "$("$PYTHON_BIN" -I - "$config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "enable_embeddings_keyword_only_flip_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            exit 1
        }

        emit_json '{"success": true, "action": "enable-embeddings", "message": "Embeddings enabled: file-plane config persisted and schema migrated. Keyword-only disabled. Run embed-backfill separately to populate vectors."}'
}

# ---------------------------------------------------------------------------
# disable-embeddings (operator-only safe rollback to keyword-only, issue #65)
# ---------------------------------------------------------------------------
#
# Explicit safe rollback from semantic search back to keyword-only:
#   1. Acquire the shared tasknotes lock nonblocking before any gbrain access.
#   2. Set search.mcp_keyword_only true FIRST so retrieval immediately falls
#      back to keyword search.
#   3. Atomically write embedding_disabled=true into the file plane (config.json)
#      via Python so direct gbrain embedding operations (embed, import) refuse
#      via assertEmbeddingEnabled. The migration command is NOT blocked (it
#      does not call assertEmbeddingEnabled), so enable-embeddings can later
#      lift the sentinel by running `migrate embeddings --no-embed` (which
#      clears embedding_disabled on success).
#   4. Do NOT delete vectors — the vectors remain on disk and can be re-activated
#      by re-running enable-embeddings (which clears the sentinel).
#
# This is the safe inverse of enable-embeddings: it flips the search mode AND
# writes the sentinel so embedding operations refuse, without destroying data.

do_disable_embeddings() {
    export_gbrain_env
    mkdir -p "$GBRAIN_STATE_DIR"
    mark_brain_repo_safe_directory

    # Acquire the tasknotes lock nonblocking before any gbrain access (safe
    # no-follow open with creation), then re-enter under the lock runner.
    run_under_lock disable-embeddings disable_embeddings || {
        case $? in
            2)
                emit_json '{"success": false, "error": "disable_embeddings_lock_busy", "message": "Could not acquire tasknotes lock; another holder is active."}'
                return 1
                ;;
            *)
                return 1
                ;;
        esac
    }

        # Set keyword-only true FIRST so retrieval immediately falls back to
        # keyword search. This is the safe rollback: even if a later step were
        # to fail, keyword search remains functional.
        config_output=$("$GBRAIN_BIN" config set search.mcp_keyword_only true 2>&1) || {
            emit_json "$("$PYTHON_BIN" -I - "$config_output" <<'PY'
import json, sys
out = sys.argv[1]
print(json.dumps({
    "success": False,
    "error": "disable_embeddings_keyword_only_flip_failed",
    "message": out[:4000],
}, ensure_ascii=False))
PY
)"
            exit 1
        }

        # Remove the completion marker (rollback means vectors are not
        # refreshed by the daily job). A removal failure is an explicit
        # structured nonzero error, not a silent success.
        rm -f "$GBRAIN_EMBEDDING_MARKER" || {
            emit_json '{"success": false, "error": "disable_embeddings_marker_removal_failed", "message": "Could not remove the embedding completion marker."}'
            exit 1
        }

        # Atomically write embedding_disabled=true into the file plane
        # (config.json) via Python so direct gbrain embedding operations
        # (embed, import) refuse via assertEmbeddingEnabled. The migration
        # command is NOT blocked (it does not call assertEmbeddingEnabled), so
        # enable-embeddings can later lift the sentinel.
        #
        # Fail-closed (issue #65 final review): the sentinel is written ONLY
        # when the existing config is missing OR a valid JSON object. If the
        # existing config cannot be read, parsed, or is a non-object (e.g. a
        # JSON array or scalar), the sentinel is NOT written and the command
        # fails with a structured error. This prevents clobbering a corrupt
        # or hand-edited config with a fresh `{embedding_disabled: true}`
        # object that would lose the operator's prior config.
        "$PYTHON_BIN" -I - "$GBRAIN_STATE_DIR" <<'PY'
import json, os, sys, tempfile
state_dir = sys.argv[1]
config_path = os.path.join(state_dir, "config.json")
# Load existing config. Fail closed when the file exists but cannot be
# read/parsed, or is a non-object. Only start fresh when the file is MISSING.
cfg = None
if os.path.exists(config_path):
    try:
        with open(config_path, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except (json.JSONDecodeError, OSError) as e:
        # Fail closed: do NOT replace a config that cannot be parsed.
        print(json.dumps({
            "success": False,
            "error": "disable_embeddings_config_unreadable",
            "message": f"Existing config.json cannot be read/parsed: {e}. Refusing to write embedding_disabled sentinel to avoid clobbering a corrupt config.",
        }, ensure_ascii=False))
        sys.exit(1)
    if not isinstance(cfg, dict):
        # Fail closed: do NOT replace a non-object config (e.g. JSON array).
        print(json.dumps({
            "success": False,
            "error": "disable_embeddings_config_not_object",
            "message": f"Existing config.json is a JSON {type(cfg).__name__}, not an object. Refusing to write embedding_disabled sentinel to avoid clobbering a non-object config.",
        }, ensure_ascii=False))
        sys.exit(1)
else:
    cfg = {}
# Set the sentinel so assertEmbeddingEnabled refuses embed/import.
cfg["embedding_disabled"] = True
# Atomic write via temp file + rename.
fd, tmp_path = tempfile.mkstemp(dir=state_dir, prefix="config.json.", suffix=".tmp")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.chmod(tmp_path, 0o600)
    os.replace(tmp_path, config_path)
except Exception:
    try:
        os.unlink(tmp_path)
    except OSError:
        pass
    raise
PY
        if [ $? -ne 0 ]; then
            # The Python block may have emitted a structured fail-closed
            # error (config_unreadable / config_not_object). Re-detect which
            # error fired so the wrapper surfaces the right structured JSON.
            # If the Python block raised (uncaught), fall back to the generic
            # sentinel_write_failed error.
            py_output=$("$PYTHON_BIN" -I - "$GBRAIN_STATE_DIR" <<'PY_CHECK' 2>/dev/null || true
import json, os, sys
state_dir = sys.argv[1]
config_path = os.path.join(state_dir, "config.json")
if os.path.exists(config_path):
    try:
        with open(config_path, "r", encoding="utf-8") as f:
            cfg = json.load(f)
        if not isinstance(cfg, dict):
            print("disable_embeddings_config_not_object")
            sys.exit(0)
    except (json.JSONDecodeError, OSError):
        print("disable_embeddings_config_unreadable")
        sys.exit(0)
print("disable_embeddings_sentinel_write_failed")
PY_CHECK
)
            case "$py_output" in
                disable_embeddings_config_unreadable)
                    emit_json '{"success": false, "error": "disable_embeddings_config_unreadable", "message": "Existing config.json cannot be read/parsed. Refusing to write embedding_disabled sentinel to avoid clobbering a corrupt config."}'
                    ;;
                disable_embeddings_config_not_object)
                    emit_json '{"success": false, "error": "disable_embeddings_config_not_object", "message": "Existing config.json is not a JSON object. Refusing to write embedding_disabled sentinel to avoid clobbering a non-object config."}'
                    ;;
                *)
                    emit_json '{"success": false, "error": "disable_embeddings_sentinel_write_failed", "message": "Failed to write embedding_disabled sentinel to config.json."}'
                    ;;
            esac
            exit 1
        fi

        emit_json '{"success": true, "action": "disable-embeddings", "message": "Embeddings disabled: keyword-only re-enabled and embedding_disabled sentinel written. Vectors preserved (not removed). Re-run enable-embeddings to re-activate (clears sentinel on migration success)."}'
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

usage() {
    emit_json '{"success": false, "error": "usage", "message": "Usage: josemar-gbrain reindex|refresh|refresh-embeddings|embed-backfill|enable-embeddings|disable-embeddings"}'
    return 1
}

drop_root_if_possible() {
    subcommand="$1"
    # Root must always drop to the hermes runtime user before any gbrain
    # access; the only skip is a PROVEN non-root effective UID. Fail closed:
    # a failed `id` lookup (missing binary, garbage output) is treated as
    # identity-unavailable and refuses to continue, never as non-root. No
    # env sentinel can bypass the drop. The su re-exec below lands as hermes,
    # so the re-entered wrapper passes this check and proceeds without
    # re-dropping.
    uid="$("$ID_BIN" -u 2>/dev/null)" || {
        emit_json '{"success": false, "error": "runtime_identity_unavailable", "message": "Could not determine the effective UID; refusing to run."}'
        return 1
    }
    case "$uid" in
        ""|*[!0-9]*)
            emit_json '{"success": false, "error": "runtime_identity_unavailable", "message": "Could not determine the effective UID; refusing to run."}'
            return 1
            ;;
    esac
    if [ "$uid" != "0" ]; then
        return 0
    fi
    if ! "$GETENT_BIN" passwd hermes >/dev/null 2>&1; then
        emit_json '{"success": false, "error": "runtime_identity_unavailable", "message": "Root execution refused: the hermes runtime user does not exist."}'
        return 1
    fi
    if [ ! -x "$SU_BIN" ]; then
        emit_json '{"success": false, "error": "runtime_identity_unavailable", "message": "Root execution refused: su is unavailable for the hermes runtime user."}'
        return 1
    fi

    runtime_home="${HERMES_HOME:-/opt/data}"
    runtime_gbrain_home="$GBRAIN_HOME"
    runtime_xdg_config="${XDG_CONFIG_HOME:-/opt/data/.config}"
    exec "$SU_BIN" -p -s /bin/sh -- hermes -c '
        runtime_home="$1"
        runtime_hermes_home="$2"
        runtime_gbrain_home="$3"
        runtime_xdg_config="$4"
        wrapper="$5"
        subcommand="$6"
        export HOME="$runtime_home"
        export HERMES_HOME="$runtime_hermes_home"
        export GBRAIN_HOME="$runtime_gbrain_home"
        export XDG_CONFIG_HOME="$runtime_xdg_config"
        exec "$wrapper" "$subcommand"
    ' sh "$runtime_home" "${HERMES_HOME:-$runtime_home}" "$runtime_gbrain_home" "$runtime_xdg_config" "$0" "$subcommand"
}

main() {
    subcommand="${1:-}"
    shift || true

    case "$subcommand" in
        reindex)
            drop_root_if_possible reindex
            do_reindex
            ;;
        refresh)
            drop_root_if_possible refresh
            do_refresh
            ;;
        refresh-embeddings)
            drop_root_if_possible refresh-embeddings
            do_refresh_embeddings
            ;;
        embed-backfill)
            drop_root_if_possible embed-backfill
            do_embed_backfill
            ;;
        enable-embeddings)
            drop_root_if_possible enable-embeddings
            do_enable_embeddings
            ;;
        disable-embeddings)
            drop_root_if_possible disable-embeddings
            do_disable_embeddings
            ;;
        *)
            usage
            ;;
    esac
}

main "$@"
