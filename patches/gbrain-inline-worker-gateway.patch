diff --git a/test/ai/e5-preprocess.test.ts b/test/ai/e5-preprocess.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..81d86e57e6542432f0e238242f5f0b7090ccf859
--- /dev/null
+++ b/test/ai/e5-preprocess.test.ts
@@ -0,0 +1,683 @@
+/**
+ * JOSEMAR PATCH (local-only E5 preprocessing proof) — pins the
+ * `query:`/`passage:` prefixing seam for recognized E5 embedding models.
+ *
+ * Why this file exists: E5-family models (e.g. `intfloat/multilingual-e5-small`)
+ * require each input to be prefixed with `query: ` or `passage: ` before
+ * embedding. Without the prefix, E5 produces a degraded / wrong vector space.
+ * gbrain's gateway had no model-gated text preprocessing; this patch adds a
+ * minimal one in the `embed()` seam, BEFORE truncation / token accounting /
+ * batching / retry, so:
+ *   - each raw input is transformed exactly once (no double prefix across
+ *     batch split / recursive halving / SDK retry),
+ *   - non-E5 models see zero behavioral change,
+ *   - the multimodal path is untouched,
+ *   - the embedding signature gains a preprocessing-version segment for E5
+ *     so raw (un-prefixed) and prefixed vectors are detected as stale /
+ *     incompatible, while non-E5 signatures stay byte-identical.
+ *
+ * Test strategy:
+ *   - The transport seam (`__setEmbedTransportForTests`) captures the
+ *     `values` array that reaches the AI SDK `embedMany()` call — the shared
+ *     lowest seam below truncation, batching, and retry. This is decisive for
+ *     the exactly-once and prefix-before-truncation properties: the values
+ *     the SDK receives are exactly what would be serialized to the wire.
+ *   - The wire-level test (`embed-input-type-wire.serial.test.ts` pattern)
+ *     mocks global fetch and asserts the outbound HTTP `input` body for the
+ *     E5 query / document-default cases — proving the prefix reaches the
+ *     actual HTTP/AI SDK boundary.
+ *   - No real provider / key / network calls: the transport is faked and
+ *     fetch is mocked.
+ *   - The op-layer enforcement tests are source-contract tests against the
+ *     patched files (src/core/ops/pages.ts, src/core/ops/search.ts,
+ *     src/commands/migrate-embeddings.ts, src/commands/embed.ts): they guard
+ *     the patch's behavioral invariants without requiring a live engine.
+ *
+ * Model representation note: gbrain stores embedding models as
+ * `provider:modelId` (colon-separated; the modelId may itself contain a
+ * slash, e.g. `llama-server:intfloat/multilingual-e5-small`). E5 detection
+ * keys off the modelId (the part after the provider prefix), so it works
+ * regardless of which openai-compatible provider hosts the GGUF.
+ */
+
+import { afterEach, beforeEach, describe, expect, test } from 'bun:test';
+import {
+  configureGateway,
+  embed,
+  embedQuery,
+  resetGateway,
+  __setEmbedTransportForTests,
+} from '../../src/core/ai/gateway.ts';
+import { currentEmbeddingSignature } from '../../src/core/embedding.ts';
+
+// ---- Transport-seam capture ------------------------------------------------
+
+interface TransportCall {
+  values: string[];
+  providerOptions: Record<string, unknown>;
+}
+const calls: TransportCall[] = [];
+
+function installCaptureTransport(dims: number): void {
+  calls.length = 0;
+  __setEmbedTransportForTests(async ({ values, providerOptions }: any) => {
+    calls.push({ values: [...values], providerOptions: { ...(providerOptions ?? {}) } });
+    return {
+      embeddings: values.map(() => new Array(dims).fill(0.1)),
+      usage: { tokens: 0 },
+    } as any;
+  });
+}
+
+// ---- Wire-seam capture (real SDK transport, mocked fetch) -------------------
+
+type FetchHandler = (url: string, init: RequestInit) => Promise<Response>;
+let fetchHandler: FetchHandler | null = null;
+const origFetch = globalThis.fetch;
+
+function openAIShapedResponse(dims: number, count: number): Response {
+  const vec = Array.from({ length: dims }, () => 0.1);
+  return new Response(
+    JSON.stringify({
+      data: Array.from({ length: count }, (_, i) => ({ object: 'embedding', index: i, embedding: vec })),
+      usage: { prompt_tokens: 3, total_tokens: 3 },
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } },
+  );
+}
+
+// ---- Config helpers ---------------------------------------------------------
+
+const E5_MODEL = 'llama-server:intfloat/multilingual-e5-small';
+const E5_DIMS = 384; // multilingual-e5-small native dim
+const OPENAI_MODEL = 'openai:text-embedding-3-large';
+const OPENAI_DIMS = 1536;
+
+function configureE5(): void {
+  configureGateway({
+    embedding_model: E5_MODEL,
+    embedding_dimensions: E5_DIMS,
+    env: {},
+  });
+}
+
+function configureOpenAI(): void {
+  configureGateway({
+    embedding_model: OPENAI_MODEL,
+    embedding_dimensions: OPENAI_DIMS,
+    env: { OPENAI_API_KEY: 'sk-fake' },
+  });
+}
+
+beforeEach(() => {
+  calls.length = 0;
+  resetGateway();
+});
+
+afterEach(() => {
+  __setEmbedTransportForTests(null);
+  globalThis.fetch = origFetch;
+  fetchHandler = null;
+  resetGateway();
+});
+
+// ---- Transport seam: prefixing reaches the SDK values ----------------------
+
+describe('E5 preprocessing — transport seam (values reaching embedMany)', () => {
+  test('E5 query: each value is prefixed with "query: " exactly once', async () => {
+    configureE5();
+    installCaptureTransport(E5_DIMS);
+
+    await embedQuery('what is foo?');
+    expect(calls.length).toBe(1);
+    expect(calls[0].values).toEqual(['query: what is foo?']);
+  });
+
+  test('E5 document default (embed, no inputType): each value is prefixed with "passage: "', async () => {
+    configureE5();
+    installCaptureTransport(E5_DIMS);
+
+    await embed(['a document', 'another document']);
+    expect(calls.length).toBe(1);
+    expect(calls[0].values).toEqual(['passage: a document', 'passage: another document']);
+  });
+
+  test('E5 explicit inputType=document also prefixes with "passage: "', async () => {
+    configureE5();
+    installCaptureTransport(E5_DIMS);
+
+    await embed(['d1', 'd2'], { inputType: 'document' });
+    expect(calls[0].values).toEqual(['passage: d1', 'passage: d2']);
+  });
+
+  test('E5 explicit inputType=query prefixes with "query: "', async () => {
+    configureE5();
+    installCaptureTransport(E5_DIMS);
+
+    await embed(['q1', 'q2'], { inputType: 'query' });
+    expect(calls[0].values).toEqual(['query: q1', 'query: q2']);
+  });
+
+  test('E5 model override via embeddingModel is detected and prefixed', async () => {
+    // Global default is OpenAI; the per-call override routes through E5 and
+    // must therefore be prefixed.
+    configureOpenAI();
+    installCaptureTransport(E5_DIMS);
+
+    await embed(['override doc'], { embeddingModel: E5_MODEL, dimensions: E5_DIMS });
+    expect(calls.length).toBe(1);
+    expect(calls[0].values).toEqual(['passage: override doc']);
+  });
+
+  test('non-E5 model (OpenAI): values are UNCHANGED (no prefix)', async () => {
+    configureOpenAI();
+    installCaptureTransport(OPENAI_DIMS);
+
+    await embed(['plain doc one', 'plain doc two']);
+    await embedQuery('plain query');
+    expect(calls[0].values).toEqual(['plain doc one', 'plain doc two']);
+    expect(calls[1].values).toEqual(['plain query']);
+  });
+
+  test('prefix is applied BEFORE truncation (long input keeps the prefix head)', async () => {
+    configureE5();
+    installCaptureTransport(E5_DIMS);
+    // MAX_CHARS = 8000. Build an input longer than the cap so truncation
+    // fires. The prefix must survive at the head of the truncated value —
+    // proving preprocessing runs before truncation, not after.
+    const longBody = 'x'.repeat(9000);
+    await embed([longBody]);
+    expect(calls.length).toBe(1);
+    const sent = calls[0].values[0];
+    expect(sent.startsWith('passage: ')).toBe(true);
+    // Truncated to MAX_CHARS (8000), so the prefix head is preserved and
+    // the tail is dropped.
+    expect(sent.length).toBe(8000);
+    expect(sent).toBe('passage: ' + 'x'.repeat(8000 - 'passage: '.length));
+  });
+
+  test('batch split / recursive halving: prefix applied EXACTLY ONCE (no double prefix)', async () => {
+    configureE5();
+    // Force recursive halving by installing a transport that throws a
+    // token-limit error on the first call (embedSubBatch halves on
+    // isTokenLimitError), then succeeds — and asserting the values seen on
+    // BOTH the failing and succeeding calls are prefixed exactly once.
+    const seen: string[][] = [];
+    let attempt = 0;
+    __setEmbedTransportForTests(async ({ values }: any) => {
+      seen.push([...values]);
+      attempt++;
+      if (attempt === 1) {
+        // Simulate a provider batch-token-limit error to trigger halving.
+        const err = new Error('Invalid \'input\': maximum request size is 300000 tokens per request.');
+        throw err;
+      }
+      return {
+        embeddings: values.map(() => new Array(E5_DIMS).fill(0.1)),
+        usage: { tokens: 0 },
+      } as any;
+    });
+
+    // Two distinct documents; the halving will split them across sub-batches.
+    await embed(['doc alpha', 'doc beta']);
+    // Every value ever sent to the transport must be prefixed exactly once.
+    for (const batch of seen) {
+      for (const v of batch) {
+        expect(v.startsWith('passage: ')).toBe(true);
+        // No double prefix.
+        expect(v.startsWith('passage: passage: ')).toBe(false);
+      }
+    }
+  });
+
+  test('repeated embed calls on the same input stay idempotent (no double prefix)', async () => {
+    // The prefix lives ABOVE the transport, so independent calls on the same
+    // raw input must each produce exactly one prefix (idempotency across the
+    // higher-level retry equivalent).
+    configureE5();
+    const seen: string[][] = [];
+    __setEmbedTransportForTests(async ({ values }: any) => {
+      seen.push([...values]);
+      return {
+        embeddings: values.map(() => new Array(E5_DIMS).fill(0.1)),
+        usage: { tokens: 0 },
+      } as any;
+    });
+
+    await embed(['retry me']);
+    await embed(['retry me']);
+    for (const batch of seen) {
+      for (const v of batch) {
+        expect(v).toBe('passage: retry me');
+      }
+    }
+  });
+});
+
+// ---- Wire seam: prefix reaches the actual HTTP body ------------------------
+
+describe('E5 preprocessing — wire body (real SDK transport, mocked fetch)', () => {
+  beforeEach(() => {
+    globalThis.fetch = (async (url: string | URL | Request, init?: RequestInit) => {
+      if (!fetchHandler) throw new Error('fetch called but no handler installed');
+      return fetchHandler(typeof url === 'string' ? url : url.toString(), init ?? {});
+    }) as typeof fetch;
+  });
+
+  test('E5 query: outbound HTTP body input is "query: <text>"', async () => {
+    configureE5();
+    let capturedBody: any = null;
+    fetchHandler = async (_url, init) => {
+      capturedBody = JSON.parse(init.body as string);
+      return openAIShapedResponse(E5_DIMS, 1);
+    };
+
+    await embedQuery('what does foo bar do?');
+    expect(capturedBody).not.toBeNull();
+    // OpenAI-shaped /v1/embeddings sends `input` as a string or array.
+    const input = capturedBody.input;
+    const inputs = Array.isArray(input) ? input : [input];
+    expect(inputs).toEqual(['query: what does foo bar do?']);
+  });
+
+  test('E5 document default: outbound HTTP body input is "passage: <text>"', async () => {
+    configureE5();
+    let capturedBody: any = null;
+    fetchHandler = async (_url, init) => {
+      capturedBody = JSON.parse(init.body as string);
+      return openAIShapedResponse(E5_DIMS, 2);
+    };
+
+    await embed(['a document being indexed', 'second document']);
+    expect(capturedBody).not.toBeNull();
+    const input = capturedBody.input;
+    const inputs = Array.isArray(input) ? input : [input];
+    expect(inputs).toEqual(['passage: a document being indexed', 'passage: second document']);
+  });
+
+  test('non-E5 (OpenAI): outbound HTTP body input is UNCHANGED', async () => {
+    configureOpenAI();
+    let capturedBody: any = null;
+    fetchHandler = async (_url, init) => {
+      capturedBody = JSON.parse(init.body as string);
+      return openAIShapedResponse(OPENAI_DIMS, 1);
+    };
+
+    await embed(['plain wire doc']);
+    const input = capturedBody.input;
+    const inputs = Array.isArray(input) ? input : [input];
+    expect(inputs).toEqual(['plain wire doc']);
+  });
+});
+
+// ---- Signature version ------------------------------------------------------
+
+describe('E5 preprocessing — embedding signature version', () => {
+  test('E5 signature carries the e5-query-passage-v1 preprocessing version', () => {
+    configureE5();
+    const sig = currentEmbeddingSignature() ?? '';
+    // Base shape is `<provider:modelId>:<dims>`; the E5 preprocessing version
+    // is appended so raw (un-prefixed) and prefixed vectors are incompatible.
+    expect(sig).toContain('intfloat/multilingual-e5-small');
+    expect(sig).toContain(`${E5_DIMS}`);
+    expect(sig).toContain('e5-query-passage-v1');
+  });
+
+  test('non-E5 signature is UNCHANGED (no preprocessing version segment)', () => {
+    configureOpenAI();
+    const sig = currentEmbeddingSignature() ?? '';
+    // Exact pre-patch shape: `<provider:modelId>:<dims>` with no version suffix.
+    expect(sig).toBe(`${OPENAI_MODEL}:${OPENAI_DIMS}`);
+    expect(sig).not.toContain('e5-query-passage');
+  });
+});
+
+// ---- Revision-aware E5 signature (issue #65) --------------------------------
+
+describe('E5 preprocessing — revision-aware signature (issue #65)', () => {
+  const E5_REVISION = '614241f622f53c4eeff9890bdc4f31cfecc418b3';
+  const E5_REVISION_ALT = 'abcdef0123456789abcdef0123456789abcdef01';
+
+  afterEach(() => {
+    delete process.env.GBRAIN_EMBEDDING_MODEL_REVISION;
+  });
+
+  test('E5 signature with revision: suffix is e5-query-passage-v1@<revision>', () => {
+    configureE5();
+    process.env.GBRAIN_EMBEDDING_MODEL_REVISION = E5_REVISION;
+    const sig = currentEmbeddingSignature() ?? '';
+    expect(sig).toContain('intfloat/multilingual-e5-small');
+    expect(sig).toContain(`${E5_DIMS}`);
+    expect(sig).toContain(`e5-query-passage-v1@${E5_REVISION}`);
+  });
+
+  test('E5 signature without revision falls back to bare preprocessing version', () => {
+    configureE5();
+    delete process.env.GBRAIN_EMBEDDING_MODEL_REVISION;
+    const sig = currentEmbeddingSignature() ?? '';
+    expect(sig).toContain('e5-query-passage-v1');
+    expect(sig).not.toContain('@');
+  });
+
+  test('revision change causes signature change (stale detection)', () => {
+    configureE5();
+    process.env.GBRAIN_EMBEDDING_MODEL_REVISION = E5_REVISION;
+    const sig1 = currentEmbeddingSignature() ?? '';
+    process.env.GBRAIN_EMBEDDING_MODEL_REVISION = E5_REVISION_ALT;
+    const sig2 = currentEmbeddingSignature() ?? '';
+    expect(sig1).not.toBe(sig2);
+    expect(sig1).toContain(E5_REVISION);
+    expect(sig2).toContain(E5_REVISION_ALT);
+  });
+
+  test('non-E5 signature is UNCHANGED regardless of revision env', () => {
+    configureOpenAI();
+    process.env.GBRAIN_EMBEDDING_MODEL_REVISION = E5_REVISION;
+    const sig = currentEmbeddingSignature() ?? '';
+    expect(sig).toBe(`${OPENAI_MODEL}:${OPENAI_DIMS}`);
+    expect(sig).not.toContain('e5-query-passage');
+    expect(sig).not.toContain(E5_REVISION);
+  });
+
+  test('empty revision env falls back to bare preprocessing version', () => {
+    configureE5();
+    process.env.GBRAIN_EMBEDDING_MODEL_REVISION = '   ';
+    const sig = currentEmbeddingSignature() ?? '';
+    expect(sig).toContain('e5-query-passage-v1');
+    expect(sig).not.toContain('@');
+  });
+});
+
+// ---- JOSEMAR PATCH (issue #65): runtime opt-in/rollback enforcement -------
+// These tests prove the embedding transport is NOT called in the disabled /
+// keyword-only paths added by the patch:
+//   - put_page forces noEmbed when config embedding_disabled=true (so the
+//     embed transport is never reached for a disabled brain),
+//   - the `query` op honors search.mcp_keyword_only=true by routing text
+//     queries to searchKeyword (no embedding transport call) and REJECTING
+//     image-only / cross_modal image/both queries (which require the
+//     embedding transport).
+//
+// Strategy: these are source-contract tests that inspect the patched source
+// to prove the enforcement seams are present and correctly structured. They
