+    expect(noWorkBlock).toContain("persistEmbeddingFileConfig(plan.to_model, plan.to_dims)");
+    expect(noWorkBlock).toContain("completeEmbeddingMigration(engine, plan)");
+  });
+
+  test('migrate-embeddings no-work path exits before probe in dry-run', () => {
+    // In dry-run mode, the no-work path must exit BEFORE any probe / persist
