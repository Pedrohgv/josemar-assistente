+  // is detected as stale and triggers re-embedding. Without this, the embed
+  // loop stamps pages with the version segment while the migration planner /
+  // invalidator / reconciler use the bare `<model>:<dims>` form, causing a
+  // signature divergence: version-stamped pages look perpetually stale to the
+  // migration planner, and raw (un-prefixed) E5 vectors are not detected as
+  // needing re-embed. See issue #65 safe E5 migration.
+  const suffix = e5SignatureSuffix(toModel);
+  return suffix ? `${base}#${suffix}` : base;
 }

