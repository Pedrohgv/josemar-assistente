# Environment variables for Josemar Assistente bot

# Z.AI API Key for GLM models (get from https://z.ai)
ZAI_API_KEY=your_zai_api_key_here

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID for the primary user (admin)
# This user will be pre-approved to chat with the bot without pairing
# Get your ID from @userinfobot on Telegram
PRIMARY_TELEGRAM_ID=123456789

# Additional users can be added following the pattern: {NAME}_TELEGRAM_ID
# Example:
# ALICE_TELEGRAM_ID=987654321
# BOB_TELEGRAM_ID=555666777
# Then add them to the runtime allowlist settings if needed

# DeepSeek API Key (optional, if using DeepSeek provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Ollama Cloud API Key (optional, for Ollama Cloud provider)
OLLAMA_API_KEY=your_ollama_api_key_here

# Tavily API Key (optional, for web search and extract)
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================
# Hermes Agent Runtime
# =============================================

# Hermes image/build pins. Override only when deliberately upgrading Hermes Base Image or gogcli.
HERMES_BASE_IMAGE=nousresearch/hermes-agent:v2026.8.3
GOGCLI_REF=e88964a1b1a46483fbc6a55ecbf2192ff522f2ea

# Josemar timezone (IANA format, defaults to America/Sao_Paulo / UTC-3)
# Used for agent system prompts, message envelope timestamps, and container clock
JOSEMAR_TIMEZONE=America/Sao_Paulo

# GOG Keyring Password (optional, for gogcli OAuth token decryption)
# Used by gogcli keyring to decrypt the local Google OAuth token store
GOG_KEYRING_PASSWORD=your_gog_keyring_password_here

# Hermes OpenAI-compatible API server for clients such as Hermes Desktop.
# Disabled by default. Use a non-empty key before binding beyond localhost.
HERMES_API_SERVER_ENABLED=false
HERMES_API_SERVER_BIND_IP=127.0.0.1
HERMES_API_SERVER_PORT=8642
HERMES_API_SERVER_KEY=
HERMES_API_SERVER_CORS_ORIGINS=
HERMES_API_SERVER_MODEL_NAME=Josemar
HERMES_DEFAULT_PROFILE_DISPLAY_NAME=Josemar

# Hermes dashboard access.
# Keep the host port bound to localhost unless another authenticated layer
# such as Cloudflare Access protects the public hostname.
HERMES_DASHBOARD_BIND_IP=127.0.0.1
HERMES_DASHBOARD_INSECURE=0
HERMES_DASHBOARD_TUI=1
# Hermes Desktop REST/WebSocket token. Use this same value in Hermes Desktop.
# Generate with: openssl rand -hex 32
HERMES_DASHBOARD_SESSION_TOKEN=
# Browser dashboard Basic Auth credentials.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Generate with: openssl rand -hex 24
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Stable session signing secret. Generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# =============================================
# Auxiliary ML Container (Optional)
# =============================================
# Feature flag consumed by Josemar skills
AUX_ML_ENABLED=false

# Compose profile activation for optional aux-ml service
# Set to "aux-ml" to start/build the auxiliary container.
COMPOSE_PROFILES=

# Optional build-time overrides.
# If local files are absent and these are left empty, compose defaults download:
# - GLM-OCR-Q8_0.gguf
# - mmproj-GLM-OCR-Q8_0.gguf
AUX_ML_GLM_OCR_URL=
AUX_ML_GLM_OCR_SHA256=
AUX_ML_GLM_OCR_MMPROJ_URL=
AUX_ML_GLM_OCR_MMPROJ_SHA256=

# llama.cpp runtime release pin. Compose defaults to the verified b9585
# Ubuntu x64 release (target commit d73cd076740db9c111d0e58ddd4486904469e75e).
# b9585 contains an embedding-scale fix relevant to Granite Speech; runtime
# validation in a real container is still required before relying on it.
# Override only when deliberately upgrading the pinned runtime.
AUX_ML_LLAMA_CPP_RELEASE_URL=
AUX_ML_LLAMA_CPP_RELEASE_SHA256=

# Granite Speech model overrides (optional).
AUX_ML_GRANITE_SPEECH_URL=
AUX_ML_GRANITE_SPEECH_SHA256=
AUX_ML_GRANITE_SPEECH_MMPROJ_URL=
AUX_ML_GRANITE_SPEECH_MMPROJ_SHA256=

# Internal service URL used by the aux-ml skill from Hermes container
AUX_ML_URL=http://aux-ml:8091

# Memory budget for the aux-ml container.
# Keep this aligned with AUX_ML_MEMORY_LIMIT_MB and largest model requirement.
AUX_ML_MEMORY_LIMIT=8192m
AUX_ML_MEMORY_LIMIT_MB=8192

# Queue and job controls
AUX_ML_MAX_QUEUE=50
AUX_ML_JOB_TIMEOUT_SECONDS=1800
AUX_ML_POLL_INTERVAL_SECONDS=2

# llama.cpp server read/write timeout used by aux-ml router and child model server
# Increase this when OCR requests can exceed 10 minutes.
AUX_ML_LLAMACPP_TIMEOUT_SECONDS=1800

# Security/limits for file-based OCR jobs
AUX_ML_ALLOWED_INPUT_DIRS=/shared
AUX_ML_ENFORCE_MEMORY_LIMIT=true
AUX_ML_OCR_MAX_PAGES=50

# Transcription (Granite Speech) tuning. Every request is normalized to
# 16 kHz mono PCM WAV with one-pass ffmpeg loudnorm (I=-16:TP=-1.5:LRA=11)
# before llama.cpp, including short/single-shot input and each long-audio
# chunk. Overlap must be strictly less than chunk size; minimum chunk size
# is 10 seconds. Explicit overrides are preserved.
AUX_ML_TRANSCRIBE_MAX_BYTES=104857600
AUX_ML_TRANSCRIBE_MAX_DURATION_SECONDS=1800
AUX_ML_TRANSCRIBE_MAX_CHUNKS=72
AUX_ML_TRANSCRIBE_CHUNK_SECONDS=30
AUX_ML_TRANSCRIBE_OVERLAP_SECONDS=2
AUX_ML_TRANSCRIBE_FFMPEG_TIMEOUT_SECONDS=300

# =============================================
# Obsidian Vault Infrastructure
# =============================================
# Docker container name prefix. Keep default unless running multiple Josemar stacks on one host.
JOSEMAR_CONTAINER_PREFIX=josemar

# Tailscale auth key used by tailscale sidecar for unattended login
# Generate in https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Node identity/options for tailscale sidecar (optional)
TAILSCALE_HOSTNAME=josemar-server
TS_EXTRA_ARGS=

# Timezone used by Syncthing and backup scheduler
TZ=America/Sao_Paulo

# Syncthing GUI/API bind IP (security default: localhost only)
# Keep 127.0.0.1 and use SSH tunnel for remote admin access
SYNCTHING_GUI_BIND_IP=127.0.0.1

# Daily backup time in 24h format (HH:MM)
OBSIDIAN_BACKUP_TIME=03:15

# Run one backup immediately on container startup
OBSIDIAN_BACKUP_RUN_ON_START=false

# Number of rotating backup slots kept in Google Drive
OBSIDIAN_BACKUP_SLOTS=5

# rclone remote name and destination path in Google Drive
OBSIDIAN_GDRIVE_REMOTE=gdrive
OBSIDIAN_GDRIVE_PATH=Josemar/obsidian-backups

# Deployment-only GitHub Actions secret (not written to .env):
# RCLONE_CONFIG_B64 contains a base64-encoded rclone.conf and is copied into
# the obsidian-rclone-config Docker volume by the deploy workflow.

# =============================================
# Agent State Repository Configuration
# =============================================
# URL of the private git repo that stores agent state under Hermes home (/opt/data)
# Create a private repo and set this to its HTTPS clone URL
WORKSPACE_STATE_REPO=https://github.com/username/josemar-agent-state.git

# GitHub PAT with repo access (set via GitHub secret WORKSPACE_REPO_TOKEN in deployment)
# For local development, set directly here (not recommended for production)
WORKSPACE_REPO_TOKEN=

# Git sync on container start (set to 'false' to skip sync)
WORKSPACE_SYNC_ON_START=true

# Hermes script-only cron interval in minutes (set to 0 to disable periodic sync)
WORKSPACE_SYNC_INTERVAL=60

# Git branch to use
WORKSPACE_GIT_BRANCH=main

# Git identity for auto-commits
WORKSPACE_GIT_USER_EMAIL=agent@josemar.local
WORKSPACE_GIT_USER_NAME=Josemar Agent

# =============================================
# GBrain Native Interface (keyword-only by default; opt-in embeddings via issue #65)
# =============================================
# gbrain is used directly via the native `gbrain` CLI for general vault work.
# The bounded TaskNotes MCP is the only specialized exception and still uses
# short-lived native gbrain commands as the sole task writer.
# Operator-only maintenance is performed by `josemar-gbrain`:
#   - `reindex`: full activation/rebuild (init, config, full sync, extract,
#     extract links, schema sync).
#   - `refresh`: incremental reconciliation of manual Obsidian/Syncthing edits
#     via `gbrain sync --no-embed`, stale extraction, and link extraction
#     (no init/schema work). Scheduled by Hermes cron (see GBRAIN_REFRESH_INTERVAL).
#   - `enable-embeddings`: opt-in native in-place embedding migration (issue #65).
#     Forces keyword-only first, runs `migrate embeddings --no-embed` (no
#     vectors produced), then only on success sets `search.mcp_keyword_only=false`
#     and clears the `embedding_disabled` sentinel. Preserves DB-only records.
#     Requires the embeddings overlay and TEI healthy.
#   - `embed-backfill`: opt-in one-time existing-vault vectorization (issue #65)
#     that finalizes the native migration state. Requires
#     GBRAIN_EMBEDDING_MODEL and GBRAIN_EMBEDDING_DIMENSIONS, acquires the shared
#     TaskNotes lock, runs at concurrency 1, verifies zero stale, and is
#     retryable. After both enable-embeddings + embed-backfill succeed,
#     `gbrain search` and `gbrain query --no-expand` both use the hybrid/
#     semantic provider path (not exact keyword).
#   - `refresh-embeddings`: only after an explicit user request; reconciles the
#     vault and embeds stale rows. The daily no-agent cron runs this same path
#     after the manual first backfill has completed.
#   - `disable-embeddings`: opt-in safe rollback to keyword-only (issue #65).
#     Sets `search.mcp_keyword_only=true` first, then writes the
#     `embedding_disabled` sentinel so `put`/`capture` stop embedding; vectors
#     and TEI are preserved (not deleted). Before enable or after disable,
#     text queries are keyword-only, image/cross-modal queries are rejected,
#     and `put`/`capture` do not embed.
# See docs/gbrain-operations.md -> "Issue #65: Opt-in TEI E5 Semantic/Hybrid
# Retrieval" for the full flow, TEI preflight, model-tuple immutability, and
# safe rollback (run disable-embeddings first; do not remove TEI first).

# gbrain runtime home (parent directory). Pinned gbrain stores its state
# (PGLite database, config) under $GBRAIN_HOME/.gbrain.
# Lives inside the existing /opt/data writable volume; no new volume is added.
GBRAIN_HOME=/opt/data

# Brain repo path gbrain indexes. Points at the Obsidian vault volume.
GBRAIN_BRAIN_REPO=/opt/data/obsidian

# Schema pack used at init. Pinned to the v2 canonical taxonomy.
# Custom schema pack (state-owned, extends gbrain-base-v2).
# The template ships a no-op starter pack at .gbrain/schema-packs/josemar/
# that reproduces the default behavior. Add your own page types by editing
# the pack.yaml in your state repo, then run josemar-gbrain reindex.
GBRAIN_SCHEMA_PACK=josemar

# Source root for custom schema packs. The source pack for the selected
# GBRAIN_SCHEMA_PACK must exist under <root>/<pack-name>/pack.yaml.
# Defaults to /opt/data/.gbrain/schema-packs (state repo .gbrain/ path).
GBRAIN_SCHEMA_SOURCE_ROOT=/opt/data/.gbrain/schema-packs

# Periodic lightweight refresh for manual Obsidian/Syncthing edits. Runs
# `josemar-gbrain refresh` every N minutes; set to 0 to disable. Refresh uses
# `gbrain sync --no-embed` even after issue #65 opt-in embeddings are enabled;
# embedding stale pages is a separate job, not folded into refresh. In phase
# one, manual vault edits need a later explicit `embed-backfill` to be
# vectorized. See docs/gbrain-operations.md -> "Issue #65".
GBRAIN_REFRESH_INTERVAL=5

# Hard timeout in seconds for one periodic refresh while it holds the shared
# TaskNotes/gbrain lock.
GBRAIN_REFRESH_TIMEOUT=240

# Daily semantic refresh cron, evaluated by Hermes in the container's LOCAL
# timezone (TZ/HERMES_TIMEZONE, America/Sao_Paulo by default) — not UTC, and
# not converted here. `0 5 * * *` means 05:00 local. Empty or 0 disables it.
GBRAIN_EMBED_REFRESH_SCHEDULE=0 5 * * *

# Outer Hermes no-agent script timeout and the inner daily refresh budget.
# The entrypoint caps the inner work timeout strictly below the outer deadline
# after TERM/KILL grace, group drain, and a safety margin. SIGTERM/SIGINT from
# an outer timeout are also forwarded to the process group.
HERMES_CRON_SCRIPT_TIMEOUT=300
GBRAIN_EMBED_REFRESH_TIMEOUT=240
GBRAIN_EMBED_REFRESH_KILL_GRACE=5
GBRAIN_EMBED_REFRESH_GROUP_DRAIN=2
GBRAIN_EMBED_REFRESH_TIMEOUT_MARGIN=10

# =============================================
# Remote Browser Control (Optional)
# =============================================
# Optional overlay that lets a laptop expose its local Chrome CDP endpoint to
# Hermes over a reverse SSH tunnel through the existing Tailscale node. Disabled
# by default for backward-compatible deploys. See docs/browser-control.md for
# the full threat model, laptop setup, and verification steps.
BROWSER_CONTROL_ENABLED=false

# Deployment-only GitHub Actions secret (not written to .env):
# BROWSER_TUNNEL_AUTHORIZED_KEY contains the dedicated single-line SSH public
# key and is copied into the browser-tunnel-authorized-keys Docker volume.

# When enabled, the deploy workflow sets:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.browser-control.yml
#   COMPOSE_PROFILES=browser-control   (added to aux-ml if also enabled)
# For local dev with the overlay, set both explicitly.

# Internal-only Docker network (defined in docker-compose.browser-control.yml)
# shared by hermes and tailscale when browser control is enabled. The
# browser-tunnel sidecar shares Hermes's network namespace and the SSH daemon
# binds only to BROWSER_CONTROL_HERMES_IP. SSH user (`tunnel`), SSH port (2222),
# and CDP port (9222) are fixed constants and not configurable.
# Defaults: subnet 172.31.250.0/29, gateway .1, Hermes .2, Tailscale .3.
# If the default subnet collides with an existing network on the host, override
# all four values together to a free /29 (or larger) and matching IPs.
BROWSER_CONTROL_SUBNET=172.31.250.0/29
BROWSER_CONTROL_GATEWAY=172.31.250.1
BROWSER_CONTROL_HERMES_IP=172.31.250.2
BROWSER_CONTROL_TAILSCALE_IP=172.31.250.3

# Tailscale Serve config is always mounted from the persistent
# tailscale-serve-config named volume (see docker-compose.yml). The deploy
# workflow writes serve.json into that volume: the real legacy TCPForward
# config when enabled, or `{}` when disabled, so stale tcp:2222 is cleared on
# every redeploy. No host bind mount is used.

# =============================================
# Local Embedding Service (Optional, NOT enabled by default)
# =============================================
# Optional overlay that runs a self-hosted Hugging Face Text Embeddings
# Inference (TEI) container and wires deployment-ready env vars into hermes.
# Disabled by default for backward-compatible deploys: the base
# docker-compose.yml is unchanged and base-only deploys are unaffected.
#
# This overlay is truly opt-in, mirroring docker-compose.browser-control.yml.
# It does NOT install or enable Mnemosyne and does NOT enable gbrain embeddings
# or alter the gbrain wrapper's keyword-only behavior by itself. The env vars
# below are INERT until the relevant provider is explicitly enabled by the
# operator: Mnemosyne via the `docker-compose.mnemosyne.yml` overlay, and gbrain
# embeddings via `josemar-gbrain enable-embeddings` + `embed-backfill` (issue
# #65). No secrets are required or stored by this overlay (the model is a
# public Hugging Face model; the cache volume holds only downloaded weights).
#
# To enable, include the overlay in COMPOSE_FILE. It can be combined with the
# existing overlays (browser-control, aux-ml) by listing all files in order:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.embeddings.yml
# or, with browser-control too:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.browser-control.yml:docker-compose.embeddings.yml
#   COMPOSE_PROFILES=browser-control   (plus aux-ml if also enabled)
# For local dev, set COMPOSE_FILE explicitly. No COMPOSE_PROFILES entry is
# needed for the embeddings overlay itself (the `embeddings` service has no
# profile and starts whenever the overlay is applied).
#
# ONE AUTHORITATIVE MODEL TUPLE: TEI, Mnemosyne, and the gbrain
# `llama-server:` provider all derive from the same selectable vars below —
# there are NO duplicated independent client-specific model/mode/url knobs.
# The tuple is:
#   EMBEDDING_MODEL_ID, EMBEDDING_MODEL_REVISION, EMBEDDING_MODEL_DIMENSIONS,
#   EMBEDDING_QUERY_PREFIX, EMBEDDING_PASSAGE_PREFIX.
# A single optional EMBEDDING_API_URL (default http://embeddings:80/v1) feeds
# both client URL vars (MNEMOSYNE_EMBEDDING_API_URL and LLAMA_SERVER_BASE_URL).
#
# NOTE on prefix routing: EMBEDDING_QUERY_PREFIX / EMBEDDING_PASSAGE_PREFIX feed
# Mnemosyne and TEI only. gbrain's E5 `query: `/`passage: ` prefixing is
# model-gated in the Josemar patch (patches/gbrain-inline-worker-gateway.patch):
# the isE5EmbeddingModel / preprocessE5Input helpers apply the prefixes for E5
# models and are a no-op for non-E5 models. These env vars do NOT configure
# gbrain's prefixing; the three consumers are independent config surfaces that
# must be kept aligned to the same model tuple.
#
# MIGRATION TUPLE: the model id, model revision, dimensions, and query/passage
# prefixes form ONE migration tuple. Changing ANY element (including revision
# drift, where the TEI-served revision no longer matches the pinned
# EMBEDDING_MODEL_REVISION) requires a full re-embedding via
# `josemar-gbrain enable-embeddings` + `josemar-gbrain embed-backfill` so
# existing vectors are not mixed with new ones. The gbrain E5 signature
# includes the revision, so a changed revision produces stale vectors and
# requires the full enable/backfill to re-vectorize, not just a restart. The
# defaults below pin `intfloat/multilingual-e5-small` at revision
# `614241f622f53c4eeff9890bdc4f31cfecc418b3` (384 dims) with the exact E5
# prefixes `query: ` and `passage: `. Override all of them together when
# switching to another model. See docs/gbrain-operations.md -> "Issue #65".

# TEI image pin. Override only when deliberately upgrading TEI.
EMBEDDING_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

# Authoritative model tuple (override all together for a different model).
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_MODEL_DIMENSIONS=384
# E5 query/passage prefixes. Defaults are the exact E5 prefixes; make both
# selectable for another model (e.g. an un-prefixed model would use empty
# strings). Keep them aligned with the model id above. Values are QUOTED so
# the trailing space survives dotenv parsing (an unquoted trailing space is
# trimmed by most dotenv parsers).
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# Optional single API URL feeding both client URL vars
# (MNEMOSYNE_EMBEDDING_API_URL and LLAMA_SERVER_BASE_URL). Default points at
# the internal TEI service on the dedicated embeddings-net network.
EMBEDDING_API_URL=http://embeddings:80/v1

# TEI bounded server settings (match the Josemar benchmark).
EMBEDDING_MAX_CONCURRENT_REQUESTS=64
EMBEDDING_MAX_BATCH_TOKENS=16384
EMBEDDING_MAX_BATCH_REQUESTS=8
EMBEDDING_MAX_CLIENT_BATCH_SIZE=64

# TEI 1.9 tracing/spans and Prometheus port. --disable-spans is passed
# explicitly so tracing/spans are off by construction. Prometheus default port
# is 9000 (not 6000); it is configured explicitly and exposed internally.
EMBEDDING_PROMETHEUS_PORT=9000

# Resource limits for the embeddings container (Josemar benchmark defaults).
# Applied as top-level Compose runtime limits (cpus / mem_limit), matching this
# repo's operational Compose style.
EMBEDDING_CPUS=2
EMBEDDING_MEM_LIMIT=4g

# Healthcheck tuning. start_period defaults to a value suitable for the first
# (cold) model download (>= 120s); keep it generous on slow links.
EMBEDDING_HEALTHCHECK_INTERVAL=30s
EMBEDDING_HEALTHCHECK_TIMEOUT=10s
EMBEDDING_HEALTHCHECK_RETRIES=5
EMBEDDING_HEALTHCHECK_START_PERIOD=300s

# NOTE on client wiring: the overlay maps the authoritative tuple above into
# the verified upstream Mnemosyne env contract
# (MNEMOSYNE_EMBEDDINGS_VIA_API=true, MNEMOSYNE_EMBEDDING_MODEL,
# MNEMOSYNE_EMBEDDING_DIM, MNEMOSYNE_EMBEDDING_QUERY_PREFIX,
# MNEMOSYNE_EMBEDDING_DOC_PREFIX, MNEMOSYNE_EMBEDDING_API_URL) and the gbrain
# `llama-server:${EMBEDDING_MODEL_ID}` provider
# (GBRAIN_EMBEDDING_MODEL, GBRAIN_EMBEDDING_DIMENSIONS, LLAMA_SERVER_BASE_URL).
# These mappings live entirely in docker-compose.embeddings.yml; there are no
# separate EMBEDDING_MNEMOSYNE_* / EMBEDDING_GBRAIN_* knobs to set here. They
# are INERT until the operator explicitly enables the relevant provider:
# Mnemosyne via the docker-compose.mnemosyne.yml overlay, and gbrain embeddings
# via `josemar-gbrain enable-embeddings` + `embed-backfill` (issue #65). After
# both succeed, `gbrain search` and `gbrain query --no-expand` use the hybrid/
# semantic provider path; before enable or after `disable-embeddings`, text
# queries are keyword-only, image/cross-modal queries are rejected, and
# `put`/`capture` do not embed. This overlay does NOT activate Mnemosyne or
# gbrain embeddings by itself.

# =============================================
# Mnemosyne Pilot (Optional, NOT enabled by default)
# =============================================
# Optional overlay that activates the Mnemosyne memory provider at runtime.
# Disabled by default for backward-compatible deploys: the base
# docker-compose.yml is unchanged and base-only deploys are unaffected.
#
# This overlay is truly opt-in and REQUIRES the embeddings overlay in the
# Compose-file sequence (it attaches hermes to embeddings-net and relies on
# the remote E5 env vars wired by docker-compose.embeddings.yml):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.embeddings.yml:docker-compose.mnemosyne.yml
# With browser-control too:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.browser-control.yml:docker-compose.embeddings.yml:docker-compose.mnemosyne.yml
#   COMPOSE_PROFILES=browser-control   (plus aux-ml if also enabled)
#
# The overlay defines NO new service, host port, data volume, or deployment
# setting. It sets MNEMOSYNE_PROVIDER=mnemosyne and validated passive env
# mirrors. The container init script (docker-hermes-init.sh) gates on
# MNEMOSYNE_PROVIDER=mnemosyne: when set, it creates the dedicated data
# directory under /opt/data, runs the pinned wrapper installer idempotently
# against the Hermes venv, and sets the full nested runtime config
# (memory.provider=mnemosyne, memory.memory_enabled=false,
# memory.user_profile_enabled=false, and the memory.mnemosyne block:
# default_scope global, profile_isolation false, auto_sleep false, reflect
# disabled_for_cron true / max_calls_per_session 0, sync_roles [user], skip
# contexts, sync turn limits 500/800, tools []) via the supported Hermes config
# interface (hermes_cli.config). When unset/empty, the init runs rollback
# cleanup (removes installer-owned plugin/skill artifacts, resets
# provider/static flags to base template values) and preserves the DB.
#
# POLICY (Phase 1 pivot): upstream-native Mnemosyne, NOT curated-static
# coexistence. MEMORY.md and USER.md remain at their versioned paths as
# explicit archive/rollback material; they are NOT injected while the pilot is
# active. memory.write_approval stays true as archive protection for built-in
# archive writes but does not prevent passive capture or necessarily all
# Mnemosyne tools. The overlay does NOT enable gbrain embeddings or alter the
# gbrain wrapper's keyword-only behavior.
#
# Full native Mnemosyne tools are available (including mutating operations);
# this is upstream-native behavior. The tools key is omitted from the nested
# config so the provider exposes all tools.
#
# The pilot is passive-only raw capture (global cross-session user turns, no
# auto-sleep, no LLM consolidation/reflection). LLM consolidation can infer
# summaries/facts but is intentionally off pending a later explicit user
# decision on LLM provider, privacy, and cost.
#
# MNEMOSYNE_DATA_DIR is the authoritative runtime storage override
# (/opt/data/mnemosyne/data). MNEMOSYNE_HOME is NOT used. The env vars below are
# valid Mnemosyne env-var mirrors (in the package's ENV_VAR_MAP); the
# authoritative nested config (profile_isolation, auto_sleep) is set by init
# because those keys have no env var mapping or use a different nested key.
# Remote E5 settings flow from the embeddings overlay. No secrets are required
# or stored by this overlay.

# Provider gate. Set to "mnemosyne" to activate at runtime; leave unset/empty
# to keep the base behavior (rollback cleanup, static injection restored).
MNEMOSYNE_PROVIDER=

# Authoritative runtime storage path (inside /opt/data, no writable-volume
# allowlist change). Default DB is /opt/data/mnemosyne/data/mnemosyne.db.
MNEMOSYNE_DATA_DIR=/opt/data/mnemosyne/data

# Validated passive env mirrors (authoritative nested config set by init).
MNEMOSYNE_DEFAULT_SCOPE=global
MNEMOSYNE_SYNC_ROLES=user
MNEMOSYNE_SKIP_CONTEXTS=cron,flush,subagent,background,skill_loop
MNEMOSYNE_SYNC_TURN_USER_LIMIT=500
MNEMOSYNE_SYNC_TURN_ASSISTANT_LIMIT=800
MNEMOSYNE_AUTO_SLEEP_ENABLED=false
MNEMOSYNE_REFLECT_DISABLED_FOR_CRON=true
MNEMOSYNE_REFLECT_MAX_CALLS_PER_SESSION=0

# =============================================
# Mnemosyne Encrypted Backup (opt-in)
# =============================================
# Optional overlay layered AFTER base + embeddings + Mnemosyne pilot:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.embeddings.yml:docker-compose.mnemosyne.yml:docker-compose.mnemosyne-backup.yml
#
# This overlay adds ONLY the separate rclone uploader service, the
# profile-gated `mnemosyne-backup-recover` recovery download step, the
# mnemosyne-backup-staging / mnemosyne-backup-state / mnemosyne-backup-recovery
# named volumes, and augments hermes with the staging RW mount, uploader-state
# RO mount, and backup env. NO host ports, NO live state mount in the
# uploader/recover services. Backup is DISABLED BY DEFAULT: the overlay is
# opt-in and the Hermes-side export cron defaults to 0 (off). The staging path
# is in HERMES_WRITABLE_VOLUMES (activation/init).
#
# DEPLOYMENT INTEGRATION: the deploy workflow selects this overlay via the
# MNEMOSYNE_DEPLOY_MODE repo variable (see below). There is no embeddings-only
# mode. See docs/mnemosyne-operations.md and
# .github/workflows/deploy-to-home-server.yml for the full integration.
#
# The uploader and recover services NEVER mount hermes-data or /opt/data. The
# staging mount is read-only in the uploader. The rclone config is read-only.
# Only the uploader state volume (uploader) and the disposable recovery volume
# (recover) are writable. Both reuse the existing secret-managed
# obsidian-rclone-config volume because it can hold a separate mnemosyne-crypt
# remote.
#
# SECRET RECOVERY REQUIREMENT: the rclone config (in the obsidian-rclone-config
# volume) must contain a `crypt` remote named per MNEMOSYNE_BACKUP_RCLONE_REMOTE.
# The crypt remote's password is the recovery secret: WITHOUT IT BACKUPS
# CANNOT BE DECRYPTED. Store the rclone config via the existing deployment
# secret mechanism (RCLONE_CONFIG_B64). In MNEMOSYNE_DEPLOY_MODE=backup the
# deploy workflow strict-base64-decodes RCLONE_CONFIG_B64 to a 0600 temp file,
# validates the crypt remote (type=crypt, nonempty remote, nonempty password)
# using the pinned rclone image, and publishes the config atomically into the
# shared obsidian-rclone-config volume. No secrets are stored here.

# DEPLOYMENT-MODE REPO VARIABLE (GitHub Actions, not in .env):
# MNEMOSYNE_DEPLOY_MODE selects the Mnemosyne overlays in the deploy workflow.
# It is a repository variable (not a secret, not written to .env). Default
# `off` preserves the baseline deploy behavior. Allowed values, validated
# before any volume mutation or service teardown:
#   off    -> base only (no Mnemosyne overlays; baseline behavior).
#   pilot  -> base + embeddings + mnemosyne overlays (TEI + Mnemosyne provider).
#   backup -> pilot + mnemosyne-backup overlay (uploader + export cron).
# There is no embeddings-only mode. Any other value is rejected by the deploy
# workflow.

# BACKUP-MODE REPO VARIABLE (GitHub Actions, not in .env):
# MNEMOSYNE_BACKUP_EXPORT_INTERVAL is REQUIRED when MNEMOSYNE_DEPLOY_MODE=backup.
# It must be a positive integer (export interval in minutes) with NO leading
# zeros (e.g. `007` is rejected) and must not exceed 10080 minutes (1 week).
# The deploy workflow verifies exactly one mnemosyne-backup-export cron job
# exists with a matching interval schedule. Ignored for off/pilot.

# Staging volume root for backup generations (exporter writes here).
MNEMOSYNE_BACKUP_STAGING_DIR=/opt/data/mnemosyne-backup/staging

# Uploader state path (read-only in hermes; writable only in the uploader
# service). The exporter observes its upload acknowledgement ledger.
MNEMOSYNE_BACKUP_UPLOADER_STATE_DIR=/opt/data/mnemosyne-backup/uploader-state

# Local staging generations to retain (minimum). The exporter prunes only
# generations explicitly acknowledged as uploaded in the uploader's ledger
# (observed read-only via MNEMOSYNE_BACKUP_UPLOADER_STATE_DIR), and only
# beyond this retained window. The current/latest generation is never
# pruned. If the ledger is unavailable/empty, no automatic deletion occurs
# (safety over convenience). Manual pruning: `mnemosyne-backup prune`.
MNEMOSYNE_BACKUP_GENERATIONS_KEEP=5

# Export interval in MINUTES. DISABLED by default (0). Wired to the opt-in
# Hermes no-agent export cron, which invokes scripts/mnemosyne-backup-export.sh
# on an `every ${interval}m` schedule. 0 = cron disabled.
MNEMOSYNE_BACKUP_EXPORT_INTERVAL=0

# REQUIRED crypt remote name. Must be rclone type 'crypt' (validated before
# upload, not just naming convention). The deploy workflow hardcodes
# `mnemosyne-crypt` in its validation and writes this value explicitly to
# .env so validation and runtime cannot diverge. Configure a separate
# mnemosyne-crypt remote in the obsidian-rclone-config volume. In backup mode
# the deploy workflow also requires the baseline `gdrive` remote so replacing
# the shared volume does not break obsidian-backup.
MNEMOSYNE_BACKUP_RCLONE_REMOTE=mnemosyne-crypt

# Remote base path for rotating full-snapshot slots.
MNEMOSYNE_BACKUP_RCLONE_PATH=Josemar/mnemosyne-backups

# Number of rotating full-snapshot remote slots (slot-1 .. slot-N).
MNEMOSYNE_BACKUP_SLOTS=5

# Uploader poll interval in SECONDS (how often it checks the staging mount
# for a new latest generation).
MNEMOSYNE_BACKUP_POLL_INTERVAL=300

# Run one upload pass on uploader startup (true/false).
MNEMOSYNE_BACKUP_RUN_ON_START=true

# Recovery lane (operator-only, on demand):
# Disposable recovery handoff dir inside the short-lived recover container
# (rclone image, `recovery` profile). The recover step downloads one immutable
# slot through crypt, verifies its manifest/SHA, and writes RECOVERY_READY
# here. A short-lived `docker compose run hermes` then verifies/installs from
# this handoff WITHOUT any rclone credentials. Never mounted into the
# long-running hermes service.
MNEMOSYNE_BACKUP_RECOVERY_DIR=/recovery
# Hermes verify-restore writes verified.db and VERIFIED_READY in this same
# disposable handoff volume; install requires their generation/SHA contract.
