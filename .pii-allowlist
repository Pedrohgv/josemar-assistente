# Regex allowlist for pii_guard.py findings.
# One regex per line. Matches against:
#   file_path:line_number:kind:value:line_text
#
# Keep this file minimal and documented when adding exceptions.
agent@josemar\.local
token@github\.com
YOUR_GATEWAY_AUTH_PASSWORD@your-domain\.com

# llama.cpp b9585 release SHA256 in docker-compose.yml; pii_guard.py can match numeric runs in the hex digest.
docker-compose\.yml:\d+:phone:.*be111dd28e6228fc4cb6a6ec41f03a67947ab61f315a3d22d0e68ac7372a58ab

# Official llama.cpp b9585 commit hash; its numeric run can resemble a phone number.
(?:\.env\.example|aux-ml/models/README\.md|docs/aux-ml\.md):\d+:phone:44[8]6904469:.*d73cd076740db9c111d0e58ddd44[8]6904469e75e

# FaQuAD-IR uses deterministic faquad-q: MD5 identifiers. Permit only numeric
# runs that are demonstrably part of those identifiers in the pinned fixture.
tests/runtime/fixtures/mnemosyne-retrieval/faquad-ir/(?:qrels|queries)\.jsonl:\d+:(?:phone|credit_card):([0-9]{10,}):.*"(?:query_id|id)": "faquad-q:[0-9a-f]*\1[0-9a-f]*"

# Numeric runs inside the pinned public FaQuAD-IR artifact SHA-256 constants.
(?:scripts/mnemosyne_retrieval_eval/(?:schema|vendor_faquad_ir)\.py|tests/runtime/fixtures/mnemosyne-retrieval/faquad-ir/manifest\.json):\d+:phone:(?:118154056[0]|191950233[2]):

# Literal test-only SSH remote, not a personal email address.
tests/runtime/test_mnemosyne_(?:backup|pilot)\.py:\d+:email:git@github\.com:.*git@github\.com

# Deterministic gbrain upstream E5 patch fixture, not a personal phone number.
patches/gbrain-inline-worker-gateway\.patch:\d+:phone:[0]123456789:.*[0]123456789

# Graphify GRAPH_REPORT.md (issue #116): community "Cohesion score" floats
# (e.g. a 0.0xxx...xxx value) can pass the Luhn credit-card check. These are
# generated graph metrics, not card numbers. Path-scoped to the report file.
# Note: CARD_RE captures a trailing space in the value, hence the ` ?`.
graphify-out/GRAPH_REPORT\.md:\d+:credit_card:\d+ ?:.*Cohesion score 0\.\d+
