#!/usr/bin/env python3

import json
import os
import shutil
import sys
import time
import traceback
import urllib.error
import urllib.request
import uuid
from pathlib import Path


AUX_ML_URL = os.getenv("AUX_ML_URL", "http://aux-ml:8091").rstrip("/")
AUX_ML_ENABLED = os.getenv("AUX_ML_ENABLED", "false").strip().lower() == "true"
AUX_ML_TIMEOUT_SECONDS = int(os.getenv("AUX_ML_JOB_TIMEOUT_SECONDS", "1800"))
AUX_ML_POLL_INTERVAL_SECONDS = float(os.getenv("AUX_ML_POLL_INTERVAL_SECONDS", "2"))
AUX_ML_SHARED_DIR = os.getenv("AUX_ML_SHARED_DIR", "/shared")


def _stage_file_for_aux_ml(file_path: str) -> str:
    """Copy a file into the shared handoff dir if not already there.

    aux-ml only sees the /shared volume, so files elsewhere in the Hermes
    container (e.g. /opt/data/image_cache/) must be staged first. Files
    already inside the shared dir are returned unchanged. Symlinks are
    not followed — a symlink inside /shared/ that points outside is
    rejected to avoid exposing unintended files to aux-ml.
    """
    source = Path(file_path)
    if not source.is_absolute():
        source = Path.cwd() / source

    shared_root = Path(AUX_ML_SHARED_DIR).resolve()

    # For files already under /shared/, return the path without copying.
    # Reject symlinks that escape the shared root.
    try:
        resolved_source = source.resolve(strict=False)
        resolved_parent = source.parent.resolve(strict=False)
    except (OSError, ValueError):
        resolved_source = source
        resolved_parent = source.parent
    source_is_in_shared = shared_root == resolved_parent or shared_root in resolved_parent.parents
    if source.is_symlink() and source_is_in_shared:
        if shared_root != resolved_source and shared_root not in resolved_source.parents:
            raise ValueError(f"Symlink inside /shared/ escapes shared root: {source}")
    if shared_root == resolved_source or shared_root in resolved_source.parents:
        return str(resolved_source)

    if not source.exists():
        raise FileNotFoundError(f"Input file does not exist: {source}")

    staged_dir = shared_root / "staged"
    staged_dir.mkdir(parents=True, exist_ok=True)
    dest = staged_dir / source.name

    # Avoid collisions: append a short suffix if the name already exists
    # and points to a different file. Retry to handle unlikely collisions.
    if dest.exists() and not _same_file(source, dest):
        for _ in range(5):
            suffix = uuid.uuid4().hex[:8]
            dest = staged_dir / f"{source.stem}_{suffix}{source.suffix}"
            if not dest.exists():
                break
        else:
            raise RuntimeError(f"Could not find a non-colliding staged path for {source}")

    shutil.copy(source, dest)
    return str(dest)


def _same_file(a: Path, b: Path) -> bool:
    try:
        return a.resolve() == b.resolve()
    except (OSError, ValueError):
        return False


def _http_json(method, path, payload=None, timeout=30):
    data = None
    headers = {"Accept": "application/json"}

    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"

    request = urllib.request.Request(
        url=f"{AUX_ML_URL}{path}",
        data=data,
        headers=headers,
        method=method,
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = response.read().decode("utf-8")
            if not body:
                return {}
            return json.loads(body)
    except urllib.error.HTTPError as exc:
        details = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"Aux ML HTTP {exc.code}: {details}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"Failed to connect to aux-ml at {AUX_ML_URL}: {exc}") from exc


def _ensure_enabled():
    if AUX_ML_ENABLED:
        return
    raise RuntimeError(
        "AUX_ML_ENABLED=false. Enable auxiliary container by setting AUX_ML_ENABLED=true and COMPOSE_PROFILES=aux-ml"
    )


def _submit_job(data):
    payload = {
        "task": data.get("task", "ocr"),
        "model": data.get("model"),
        "file_path": data.get("file_path"),
        "prompt": data.get("prompt"),
        "column_split": data.get("column_split", 1),
        "column_split_pages": data.get("column_split_pages"),
    }
    if not payload["file_path"]:
        return {"success": False, "error": "Missing required field: file_path"}
    try:
        payload["file_path"] = _stage_file_for_aux_ml(payload["file_path"])
    except (OSError, FileNotFoundError, ValueError) as exc:
        return {"success": False, "error": f"Failed to stage input file: {exc}"}
    return _http_json("POST", "/jobs", payload=payload, timeout=30)


def _job_status(job_id):
    return _http_json("GET", f"/jobs/{job_id}", timeout=30)


def _wait_for_job(job_id, timeout_seconds):
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        job = _job_status(job_id)
        status = job.get("status")
        if status == "succeeded":
            return {
                "success": True,
                "job_id": job_id,
                "status": status,
                "result": job.get("result"),
                "job": job,
            }
        if status == "failed":
            return {
                "success": False,
                "job_id": job_id,
                "status": status,
                "error": job.get("error", "Job failed"),
                "job": job,
            }
        if status == "cancelled":
            return {
                "success": False,
                "job_id": job_id,
                "status": status,
                "error": "Job was cancelled",
                "job": job,
            }
        time.sleep(AUX_ML_POLL_INTERVAL_SECONDS)

    return {
        "success": False,
        "job_id": job_id,
        "status": "timeout",
        "error": f"Timed out waiting for job after {timeout_seconds}s",
    }


def _cancel_job(job_id):
    return _http_json("POST", f"/jobs/{job_id}/cancel", timeout=30)


def action_ocr_file(data):
    payload = {
        "task": "ocr",
        "model": data.get("model", "glm-ocr"),
        "file_path": data.get("file_path"),
        "prompt": data.get("prompt"),
        "column_split": data.get("column_split", 1),
        "column_split_pages": data.get("column_split_pages"),
    }
    if not payload["file_path"]:
        return {"success": False, "error": "Missing required field: file_path"}

    try:
        payload["file_path"] = _stage_file_for_aux_ml(payload["file_path"])
    except (OSError, FileNotFoundError, ValueError) as exc:
        return {"success": False, "error": f"Failed to stage input file: {exc}"}

    submitted = _http_json("POST", "/jobs", payload=payload, timeout=30)

    should_wait = data.get("wait", True)
    if not should_wait:
        return {
            "success": True,
            "job_id": submitted.get("job_id"),
            "status": submitted.get("status"),
            "submitted": submitted,
        }

    timeout_seconds = int(data.get("timeout_seconds", AUX_ML_TIMEOUT_SECONDS))
    return _wait_for_job(submitted.get("job_id"), timeout_seconds)


def action_submit_job(data):
    submitted = _submit_job(data)
    if submitted.get("success") is False:
        return submitted
    return {
        "success": True,
        "job_id": submitted.get("job_id"),
        "status": submitted.get("status"),
        "submitted": submitted,
    }


def action_job_status(data):
    job_id = data.get("job_id")
    if not job_id:
        return {"success": False, "error": "Missing required field: job_id"}
    job = _job_status(job_id)
    return {"success": True, "job": job}


def action_wait_for_job(data):
    job_id = data.get("job_id")
    if not job_id:
        return {"success": False, "error": "Missing required field: job_id"}

    timeout_seconds = int(data.get("timeout_seconds", AUX_ML_TIMEOUT_SECONDS))
    return _wait_for_job(job_id, timeout_seconds)


def action_cancel_job(data):
    job_id = data.get("job_id")
    if not job_id:
        return {"success": False, "error": "Missing required field: job_id"}
    try:
        result = _cancel_job(job_id)
    except RuntimeError as exc:
        return {"success": False, "error": str(exc), "job_id": job_id}
    cancelled = bool(result.get("cancelled", False))
    return {
        "success": cancelled,
        "job_id": job_id,
        "status": result.get("status"),
        "cancelled": cancelled,
        "message": result.get("message"),
        "job": result,
    }


def action_queue_status(_data):
    queue = _http_json("GET", "/queue", timeout=30)
    return {"success": True, "queue": queue}


def action_health(_data):
    health = _http_json("GET", "/health", timeout=30)
    return {"success": True, "health": health}


ACTIONS = {
    "ocr_file": action_ocr_file,
    "submit_job": action_submit_job,
    "job_status": action_job_status,
    "wait_for_job": action_wait_for_job,
    "cancel_job": action_cancel_job,
    "queue_status": action_queue_status,
    "health": action_health,
}


def main():
    try:
        input_data = sys.stdin.read().strip()
        if not input_data:
            result = {
                "success": False,
                "error": "No input provided",
                "usage": {
                    "actions": list(ACTIONS.keys()),
                    "example": {
                        "action": "ocr_file",
                        "file_path": "/shared/document.pdf",
                        "wait": True,
                    },
                },
            }
            print(json.dumps(result, indent=2, ensure_ascii=False))
            sys.exit(1)

        try:
            data = json.loads(input_data)
        except json.JSONDecodeError as exc:
            print(json.dumps({"success": False, "error": f"Invalid JSON: {exc}"}, indent=2, ensure_ascii=False))
            sys.exit(1)

        action = data.get("action")
        handler = ACTIONS.get(action)
        if handler is None:
            print(
                json.dumps(
                    {
                        "success": False,
                        "error": f"Unknown action: {action}",
                        "valid_actions": list(ACTIONS.keys()),
                    },
                    indent=2,
                    ensure_ascii=False,
                )
            )
            sys.exit(1)

        _ensure_enabled()
        result = handler(data)
        print(json.dumps(result, indent=2, ensure_ascii=False))
        sys.exit(0 if result.get("success") else 1)

    except Exception as exc:
        print(
            json.dumps(
                {
                    "success": False,
                    "error": str(exc),
                    "traceback": traceback.format_exc(),
                },
                indent=2,
                ensure_ascii=False,
            )
        )
        sys.exit(1)


if __name__ == "__main__":
    main()
