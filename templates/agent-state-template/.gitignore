# Deny-by-default. /opt/data is both Hermes home and the private
# agent-state git worktree, so runtime files must never be staged by accident.
*

# Repo control files
!.gitignore
!.sync-manifest

# Root state files
!AGENTS.md
!SOUL.md
!BOOT.md

# Hermes-native memory state
!memories/
!memories/MEMORY.md
!memories/USER.md

# Hermes-native cron state
!cron/
!cron/jobs.json

# User-owned skills
!skills/
!skills/.gitkeep

# Avatar assets
!avatars/
!avatars/.gitkeep
!avatars/**
