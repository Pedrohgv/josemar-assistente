# Deny-by-default. /opt/data is both Hermes home and the private
# agent-state git worktree, so runtime files must never be staged by accident.
*

# Repo control files
!.gitignore
!.sync-manifest

# Root state files
!AGENTS.md
!SOUL.md
!BOOT.md

# Hermes-native memory state
!memories/
!memories/MEMORY.md
!memories/USER.md

# Hermes-native cron state
!cron/
!cron/jobs.json

# User-owned skills
!skills/
!skills/.gitkeep
!skills/**

# Avatar assets
!avatars/
!avatars/.gitkeep
!avatars/**

# User-owned gbrain schema pack source (narrow allowlist, not broad gbrain/**)
!.gbrain/
!.gbrain/schema-packs/
!.gbrain/schema-packs/josemar/
!.gbrain/schema-packs/josemar/pack.yaml

# Josemar state-backed Hermes skill toggles. Only the dedicated toggle JSON
# sidecars are versioned, never the full config.yaml. The lock file and any
# other hermes/ artifacts stay ignored.
!hermes/
!hermes/skill-toggles/
!hermes/skill-toggles/default.json
!hermes/skill-toggles/profiles/
!hermes/skill-toggles/profiles/*.json

# Josemar state-owned Hermes model selections. Strict selection-only v1
# contract (no profiles/multiplexing). ONLY provider/model selection is
# versioned — no base_url, api_mode, extra_body, timeouts, token limits,
# fallback_chain, credentials, provider definitions, or topology. The lock
# file and any other hermes/ artifacts stay ignored by deny-by-default.
!hermes/models.yaml

# Josemar state-owned Hermes runtime command allowlist sidecars. Same
# narrow family as the skill toggles: ONLY the exact default.json, the
# exact migration-v1.json marker, and the profiles/*.json sidecars are
# un-ignored. The shared lock file, the runtime config, and any other
# hermes/ artifact stay ignored by deny-by-default.
!hermes/command-allowlist/
!hermes/command-allowlist/default.json
!hermes/command-allowlist/migration-v1.json
!hermes/command-allowlist/profiles/
!hermes/command-allowlist/profiles/*.json
