# Deny-by-default. /opt/data is both Hermes home and the private
# agent-state git worktree, so runtime files must never be staged by accident.
*

# Repo control files
!.gitignore
!.sync-manifest

# Root state files
!AGENTS.md
!SOUL.md
!BOOT.md

# Hermes-native memory state
!memories/
!memories/MEMORY.md
!memories/USER.md

# Hermes-native cron state
!cron/
!cron/jobs.json

# User-owned skills
!skills/
!skills/.gitkeep
!skills/**

# Avatar assets
!avatars/
!avatars/.gitkeep
!avatars/**

# User-owned gbrain schema pack source (narrow allowlist, not broad gbrain/**)
!gbrain/
!gbrain/schema-packs/
!gbrain/schema-packs/josemar-user/
!gbrain/schema-packs/josemar-user/pack.yaml
!gbrain/schema-packs/josemar-user/README.md
