# Core state files
AGENTS.md
SOUL.md
BOOT.md

# Hermes memory files
memories/USER.md
memories/MEMORY.md

# User-owned skills. workspace-sync auto-registers files for skill directories
# containing SKILL.md. Do not use broad skills/* patterns because /opt/data/skills
# can contain runtime-installed skill-hub artifacts.
skills/.gitkeep

# Avatars
avatars/*

# Hermes cron jobs
cron/jobs.json

# User-owned gbrain schema pack source (narrow explicit paths only).
# Do NOT use broad gbrain/** — runtime .gbrain is protected and must
# never be versioned.
.gbrain/schema-packs/josemar/pack.yaml

# Josemar state-backed Hermes skill toggles. Only the dedicated toggle JSON
# sidecars are versioned, never the full config.yaml. default.json may be
# absent on a pre-feature deployment; absence is acceptable.
hermes/skill-toggles/default.json
hermes/skill-toggles/profiles/*.json

# Josemar state-owned Hermes model selections. Strict selection-only v1
# contract (no profiles/multiplexing). ONLY provider/model selection is
# versioned — no base_url, api_mode, extra_body, timeouts, token limits,
# fallback_chain, credentials, provider definitions, or topology. State
# changes are validated before sync commit; invalid files are rejected.
# Dashboard model changes are not source of truth.
hermes/models.yaml

# Josemar state-owned Hermes runtime command allowlist sidecars. Same
# default/profile layout as the skill toggles: default.json mirrors the
# workspace root and profiles/*.json mirrors named profiles. Presence is
# authoritative: an explicit [] keeps the runtime root-level
# command_allowlist key durably empty while an absent sidecar removes
# that key. Sidecars are validated by workspace-sync before staging,
# before every push, and before remote merge (fail-closed); deletion is
# a valid rollback path. Nothing else under hermes/ is versioned — the
# full config.yaml is never tracked.
hermes/command-allowlist/default.json
hermes/command-allowlist/profiles/*.json
